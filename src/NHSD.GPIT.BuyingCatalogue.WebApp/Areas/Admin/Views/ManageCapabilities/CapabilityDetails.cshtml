@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Admin.Models.ManageCapabilities.ManageCapabilityModel

@{
    ViewBag.Title = "Capability details";
}

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-full">
        <partial name="Partials/_BackLink" model="Model" />
        <nhs-page-title title="@ViewBag.Title" advice="" />

        <form method="post">
            <div class="nhsuk-u-margin-bottom-9">
                <input type="hidden" asp-for="BackLink" />
                <input type="hidden" asp-for="Id" />

                <nhs-input asp-for="CapabilityRef" label-text="Reference" />
                <nhs-input asp-for="Name" label-text="Name" />
                <nhs-textarea asp-for="Description" 
                              label-text="Description"
                              number-of-rows="4" />
                <nhs-input asp-for="SourceUrl" label-text="Source URL" />

                @if (Model.EpicsExpanderModel?.Epics.Count() > 0)
                {
                    <partial name="_EpicsExpander" model="Model.EpicsExpanderModel" />
                }

                @if (Model.CatalogueItemsExpanderModel?.CatalogueItems.Count() > 0)
                {
                    <partial name="_CatalogueItemsExpander" model="Model.CatalogueItemsExpanderModel" />
                }

                <nhs-fieldset-form-label asp-for="@Model"
                                         label-text="Capability status"
                                         label-hint="Select one option."
                                         size="Medium">
                    <nhs-radio-buttons asp-for="Status"
                                       values="Model.AvailableStatuses.Cast<object>()"
                                       value-name="Value"
                                       display-name="Text" />
                </nhs-fieldset-form-label>
            </div>

            <nhs-submit-button />
        </form>
    </div>
</div>
