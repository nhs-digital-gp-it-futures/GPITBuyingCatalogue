@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Admin.Models.SupplierServices.AssociatedServicesModel;
@{
    ViewBag.Title = "Associated services";
}
<partial name="Partials/_BackLink" model="Model"/>
<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-full">
        <nhs-validation-summary/>
        <nhs-page-title title="@ViewBag.Title"
                        caption="@Model.SupplierName"
                        advice="If an associated service is not listed, you can add it using the link. It’ll then be available for selection on all your catalogue items."/>

        <vc:nhs-action-link url="@Url.Action(
                                     nameof(SupplierServicesController.AddAssociatedService),
                                     typeof(SupplierServicesController).ControllerName(),
                                     new { supplierId = Model.SupplierId })" text="Add an associated service"/>

        @if (Model.AssociatedServices.Any())
        {
            <nhs-fieldset-form-container asp-for="@Model.AssociatedServices">
                <nhs-table data-test-id="associated-services-table" label-text="Associated services available">
                    <nhs-table-column>
                        ID
                    </nhs-table-column>
                    <nhs-table-column>
                        Associated service
                    </nhs-table-column>
                    <nhs-table-column>
                        Description
                    </nhs-table-column>
                    <nhs-table-column>
                        Status
                    </nhs-table-column>
                    <nhs-table-column>Action</nhs-table-column>
                    @foreach (var associatedService in Model.AssociatedServices)
                    {
                        <nhs-table-row-container>
                            <nhs-table-cell style="white-space:nowrap">
                                @associatedService.CatalogueItemId
                            </nhs-table-cell>
                            <nhs-table-cell>
                                @associatedService.CatalogueItem.Name
                            </nhs-table-cell>
                            <nhs-table-cell>
                                @associatedService.Description
                            </nhs-table-cell>
                            <nhs-table-cell>
                                <nhs-tag status-enum="@associatedService.CatalogueItem.PublishedStatus"/>
                            </nhs-table-cell>
                            <nhs-table-cell>
                                <a asp-action="@nameof(SupplierServicesController.EditAssociatedService)"
                                   asp-controller="@typeof(SupplierServicesController).ControllerName()"
                                   asp-route-supplierId="@Model.SupplierId"
                                   asp-route-associatedServiceId="@associatedService.CatalogueItemId"
                                   data-test-id="edit-link" class="nhsuk-breadcrumb__link">Edit</a>
                            </nhs-table-cell>
                        </nhs-table-row-container>
                    }
                </nhs-table>
            </nhs-fieldset-form-container>
        }
        <vc:nhs-anchor-button text="Save and continue" url="@(Model.BackLink)" type="Primary"/>
    </div>
</div>
