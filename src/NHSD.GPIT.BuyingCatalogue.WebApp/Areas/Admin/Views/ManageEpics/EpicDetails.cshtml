@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Admin.Models.ManageEpics.ManageEpicModel

@{
    ViewBag.Title = "Epic - " + Model.Id;
}

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-full">
        <partial name="Partials/_BackLink" model="Model" />
        <nhs-page-title title="@ViewBag.Title" advice="" />

        <form method="post">
            <div class="nhsuk-u-margin-bottom-9">
                <input type="hidden" asp-for="BackLink" />
                <input type="hidden" asp-for="Id" />

                <nhs-input asp-for="Name" label-text="Name" />
                <nhs-input asp-for="Description" label-text="Description" />
                <nhs-input asp-for="SourceUrl" label-text="Source URL" />

                @if (Model.CapabilitiesExpanderModel?.Capabilities.Count() > 0)
                {
                    <partial name="_CapabilitiesExpander" model="Model.CapabilitiesExpanderModel" />
                }

                <nhs-fieldset-form-label asp-for="@Model"
                                         label-text="Is active?"
                                         label-hint=""
                                         size="Medium">
                    <nhs-radio-buttons asp-for="IsActive"
                                       values="Model.IsActiveOptions.Cast<object>()"
                                       value-name="Value"
                                       display-name="Text" />
                </nhs-fieldset-form-label>
            </div>

            <nhs-submit-button />
        </form>
    </div>
</div>
