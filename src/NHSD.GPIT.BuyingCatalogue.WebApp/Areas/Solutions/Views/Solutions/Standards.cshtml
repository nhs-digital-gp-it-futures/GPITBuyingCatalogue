@using NHSD.GPIT.BuyingCatalogue.EntityFramework.Catalogue.Models
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Solutions.Models
@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Solutions.Models.SolutionStandardsModel

@{
    var overarchingStandards = Model.Standards.Where(s => s.Type == StandardType.Overarching).OrderBy(s => s.Name).ToList();
    var supplementaryCareStandards = Model.Standards.Where(s => s.Type == StandardType.SupplementaryCare).OrderBy(s => s.Name).ToList();
    var otherStandards = Model.Standards.Where(s => s.Type == StandardType.Other).OrderBy(s => s.Name).ToList();

    var shouldShowOverarchingAction = overarchingStandards.Any(s => Model.StandardsWithWorkOffPlans.Any(swp => swp == s.Id));
    var shouldShowSupplementaryCareStandardsAction = supplementaryCareStandards.Any(s => Model.StandardsWithWorkOffPlans.Any(swp => swp == s.Id));
    var shouldShowOtherStandardsAction = otherStandards.Any(s => Model.StandardsWithWorkOffPlans.Any(swp => swp == s.Id));

    var overarchingStandardsExpanderModel = new SolutionStandardsExpanderModel(
        "Overarching Standards",
        "These Standards must be fully met by all catalogue solutions within an agreed timeframe",
        "overarching-table",
        overarchingStandards, Model.StandardsWithWorkOffPlans, Model.SolutionId, shouldShowOverarchingAction);

    var supplementaryCareStandardsExpanderModel = new SolutionStandardsExpanderModel(
        "Supplementary Care Standards",
        "The requirements in a Supplementary Care Standard describe a care domain specific service, feature or operating capability that a catalogue solution must meet.",
        "supplementary-care-table",
        supplementaryCareStandards, Model.StandardsWithWorkOffPlans, Model.SolutionId, shouldShowSupplementaryCareStandardsAction);

    var otherStandardsExpanderModel = new SolutionStandardsExpanderModel(
        "Other Standards",
        "These Standards are relevant to solutions that meet particular Capabilities",
        "other-table",
        otherStandards, Model.StandardsWithWorkOffPlans, Model.SolutionId, shouldShowOtherStandardsAction);
}
<partial name="_solutionSummary" model="Model" />
<p>
    Standards describe the technical specifications or operating conditions required for a catalogue solution to be published on the Buying Catalogue. This is how @Model.SolutionName has performed against the relevant Standards:
</p>

<nhs-details label-text="Standards not fully met">
    <p>Any Standard that has not been fully met will have a status of ‘in progress’ and the catalogue solution will be subject to a Compliance Work-off Plan.</p>
    <p>This means the supplier has agreed to complete any outstanding work to meet the Standard within an agreed timeframe.</p>
    <p>Use the ‘view details’ link to find more information about any outstanding Work-off Plans.</p>
</nhs-details>

<partial name="_StandardsExpander" model="overarchingStandardsExpanderModel"/>

@if (supplementaryCareStandards.Count > 0)
{
    <partial name="_StandardsExpander" model="supplementaryCareStandardsExpanderModel" />
}
@if (otherStandards.Count > 0)
{
    <partial name="_StandardsExpander" model="otherStandardsExpanderModel"/>
}
