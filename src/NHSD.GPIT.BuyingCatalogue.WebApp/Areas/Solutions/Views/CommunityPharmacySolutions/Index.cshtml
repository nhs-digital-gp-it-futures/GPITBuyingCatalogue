@using NHSD.GPIT.BuyingCatalogue.Framework.Extensions
@using NHSD.GPIT.BuyingCatalogue.ServiceContracts.Models
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Solutions.Controllers
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Solutions.Models
@using NHSD.GPIT.BuyingCatalogue.WebApp.Controllers
@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Solutions.Models.CommunityPharmacySolutionsModel;
@{
    var pageTitle = CommunityPharmacySolutionsModel.PageTitle;
    ViewBag.Title = pageTitle;
    Layout = "~/Views/Shared/Layouts/_AllBannersLayout.cshtml";

    var totalNumberOfSolutions = Model.ResultsModel.PageOptions.TotalNumberOfItems;
    var solutionDisplayPerPage = CommunityPharmacySolutionsModel.SearchResultsPerPage;
    var currentPageNumber = Model.ResultsModel.PageOptions.PageNumber;
    var totalNumberOfPages = Model.ResultsModel.PageOptions.NumberOfPages;
    var textPluralisation = totalNumberOfSolutions > 1 ? "solutions" : "solution";
    var solutionDisplayTotal = currentPageNumber switch
    {
        _ when solutionDisplayPerPage >= totalNumberOfSolutions => $"Showing {totalNumberOfSolutions} {textPluralisation}",
        _ when currentPageNumber < totalNumberOfPages => $"Showing {solutionDisplayPerPage} of {totalNumberOfSolutions} {textPluralisation}",
        _ when currentPageNumber == totalNumberOfPages => $"Showing {totalNumberOfSolutions - (currentPageNumber - 1) * solutionDisplayPerPage} of {totalNumberOfSolutions} {textPluralisation}",
        _ => throw new ArgumentException(),
    };
}

@section Scripts {
    <script type="text/javascript" src="@Url.Content("~/js/Filters.min.js")" asp-append-version="true"></script>
}

@section Breadcrumbs {
    <nav class="nhsuk-breadcrumb" aria-label="Breadcrumb">
        <div class="nhsuk-width-container">
            <ol class="nhsuk-breadcrumb__list">
                <li class="nhsuk-breadcrumb__item">
                    <a asp-action="@nameof(HomeController.Index)"
                       asp-controller="@typeof(HomeController).ControllerName()"
                       class="nhsuk-breadcrumb__link">Home</a>
                </li>
                <li class="nhsuk-breadcrumb__item">
                    <a asp-action="@nameof(CommunityPharmacySolutionsController.Index)"
                       asp-controller="@typeof(CommunityPharmacySolutionsController).ControllerName()"
                       class="nhsuk-breadcrumb__link">Community Pharmacy</a>
                </li>
                <li class="nhsuk-breadcrumb__item">
                    Pharmacy Solutions
                </li>
            </ol>
        </div>
    </nav>
}

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds" id="search">
        <nhs-page-title title="@pageTitle" />
        
        <h2 class="nhsuk-u-margin-top-9">Search for solutions or suppliers</h2>
        <nhs-hint-text>View assured solutions for community pharmacy services</nhs-hint-text>
        <div id="search-by">
            <vc:nhs-suggestion-search id="marketing-suggestion-search"
                                      ajax-url="@Url.Action(nameof(CommunityPharmacySolutionsController.FilterSearchSuggestions), typeof(CommunityPharmacySolutionsController).ControllerName())"
                                      title-text="Search"
                                      hide-label="true"
                                      placeholder-text="Search by service, solution or supplier"
                                      query-parameter-name="search"/>
        </div>
    </div>
    
    
    <div class="nhsuk-grid-column-full nhsuk-u-margin-top-5" id="solutions-list">
        <div class="nhsuk-u-clear">
            <p class="bc-u-block-float-left">@solutionDisplayTotal</p>
            @if (Model.ResultsModel.CatalogueItems.Count != 0)
            {
                <div style="float: right"
                     id="solution-sort-container"
                     data-default-sort-by="@PageOptions.SortOptions.LastPublished"
                     data-results-url="@Url.Action(nameof(CommunityPharmacySolutionsController.Index), typeof(CommunityPharmacySolutionsController).ControllerName())"></div>
            }
        </div>
        
        @foreach (var item in Model.ResultsModel.CatalogueItems)
        {
            <partial name="_CommunityPharmacySolutionSearchResult" model="@(new SolutionSearchResultModel(item, false))"/>
        }
        
        <govuk-pagination
            current-page-number="@Model.ResultsModel.PageOptions.PageNumber" 
            total-number-of-pages="@Model.ResultsModel.PageOptions.NumberOfPages" />
    </div>
</div>
