@using NHSD.GPIT.BuyingCatalogue.ServiceContracts.Routing
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Controllers.SolutionSelection
@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.SolutionSelection.TaskList.TaskListModel

@{
    ViewBag.Title = Model.Title;

    var addAdditionalServicesLink = Url.Action(
        nameof(AdditionalServicesController.SelectAdditionalServices),
        typeof(AdditionalServicesController).ControllerName(),
        new { Model.InternalOrgId, Model.CallOffId });

    var addAssociatedServicesLink = Url.Action(
        nameof(AssociatedServicesController.SelectAssociatedServices), 
        typeof(AssociatedServicesController).ControllerName(), 
        new { Model.InternalOrgId, Model.CallOffId, source = RoutingSource.TaskList});

    var changeCatalogueSolutionLink = Url.Action(nameof(CatalogueSolutionsController.EditSolution), typeof(CatalogueSolutionsController).ControllerName(), new { Model.InternalOrgId, Model.CallOffId });
}

<partial name="Partials/_BackLink" model="Model" />

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-full">
        <nhs-validation-summary />
        <nhs-page-title model="Model" />
    </div>
    <div class="nhsuk-grid-column-two-thirds">
        @if (Model.CatalogueSolution != null || Model.OrderType.AssociatedServicesOnly)
        {
            <h2 class="nhsuk-u-margin-bottom-6">Catalogue solution</h2>
            <nhs-card-v2>
                <nhs-card-content>
                @if (Model.OrderType.AssociatedServicesOnly)
                {
                    <h3 class="nhsuk-card__heading heading nhsuk-u-margin-bottom-5">@Model.SolutionName</h3>
                }
                else
                {
                    <partial name="TaskListOrderItem"
                                model="@Model.OrderItemModel(Model.CatalogueSolution.CatalogueItemId)" />
                }
                </nhs-card-content>
                <nhs-card-footer>
                    @if (!Model.IsAmendment)
                    {
                        if (Model.AlternativeSolutionsAvailable)
                        {
                            <vc:add-or-change href="@changeCatalogueSolutionLink" noun-phrase="Catalogue solution" is-change="true" />
                        }
                        else
                        {
                            <vc:inline-information text="There is only 1 solution offered by this supplier." />
                        }
                    }
                    else
                    {
                        <vc:inline-information text="You cannot change your catalogue solution when amending an order." />
                    }
                </nhs-card-footer>

            </nhs-card-v2>
        }

        @if (!Model.OrderType.AssociatedServicesOnly)
        {
            <h2 class="nhsuk-heading-l nhsuk-u-margin-bottom-6">Additional services</h2>
            <nhs-card-v2>
                @if (Model.AdditionalServicesAvailable)
                {
                    <nhs-card-content>
                        @if (Model.AdditionalServices.Any())
                        {
                            @foreach (var service in Model.AdditionalServices)
                            {
                                <partial name="TaskListOrderItem"
                                model="@Model.OrderItemModel(service.CatalogueItemId)" />
                            }
                        }
                        else
                        {
                            <p>No additional services have been added to this order yet.</p>
                        }
                    </nhs-card-content>
                    <nhs-card-footer>
                        @if (Model.UnselectedAdditionalServicesAvailable)
                        {
                            <vc:add-or-change href="@addAdditionalServicesLink" noun-phrase="Additional services" />
                        }
                        else
                        {
                            <vc:inline-information text="All the additional services available for this catalogue solution have already been added." />
                        }
                    </nhs-card-footer>
                }
                else
                {
                    <nhs-card-content>
                        <vc:inline-information text="There are no additional services available for this catalogue solution." />
                    </nhs-card-content>
                }
            </nhs-card-v2>
        }

            <h2 class="nhsuk-heading-l nhsuk-u-margin-bottom-6">Associated services</h2>
            @if (!Model.AssociatedServicesAvailable)
            {
                <nhs-card-v2>
                    <nhs-card-content>
                        <vc:inline-information text="There are no associated services available for this catalogue solution." />
                    </nhs-card-content>
                </nhs-card-v2>
                
            }
            else
            {
                <h3 class="nhsuk-heading-m nhsuk-u-margin-bottom-6">Associated Services for this order</h3>
                <nhs-card-v2>
                    <nhs-card-content>
                        @if (Model.AssociatedServices.Any())
                        {
                            @foreach (var service in Model.AssociatedServices)
                            {
                                <partial name="TaskListOrderItem"
                                         model="@Model.OrderItemModel(service.CatalogueItemId)" />
                            }
                        }
                        else
                        {
                            <p>No associated services have been added to this order</p>
                        }
                    </nhs-card-content>
                    <nhs-card-footer>
                        @if (Model.OrderType.MergerOrSplit)
                        {
                            <vc:inline-information text="Associated services cannot be changed." />
                        }
                        else if (!Model.UnselectedAssociatedServicesAvailable)
                        {
                            <vc:inline-information text="All the associated services available for this catalogue solution have already been added." />
                        }
                        else if (Model.IsAmendment && !Model.HasNewRecipients)
                        {
                            <vc:inline-information text="You cannot add any new associated services without adding any new service recipients to this order" />
                        }
                        else
                        {
                            <vc:add-or-change href="@addAssociatedServicesLink" noun-phrase="Associated services" />
                        }
                    </nhs-card-footer>
                </nhs-card-v2>
                @if (Model.IsAmendment && Model.PreviousAssociatedServices.Any())
                {
                    <h3 class="nhsuk-heading-m nhsuk-u-margin-bottom-6">Previously ordered associated services</h3>
                    <p>View details about associated services that have been ordered before.</p>
                    <p>Prices and quantities for previously ordered associated services reflect what was agreed at the time the order was placed.</p>
                    
                    <nhs-inset-text>You cannot change your original associated services when amending an order</nhs-inset-text>
                    
                    @foreach (var grouping in Model.PreviousAssociatedServices.Reverse())
                    {
                        var callOffId = grouping.Key;
                        <nhs-expander label-text="@callOffId" open="@false">
                            @foreach (var item in grouping)
                            {
                                var itemModel = @Model.OrderItemModelForPrevious(callOffId, item.CatalogueItemId);
                                itemModel.QuantityViewCallOffId = callOffId;
                                <partial name="TaskListOrderItem"
                                         model="@itemModel"/>
                            }
                        </nhs-expander>
                    }
                }
            }

        <vc:nhs-anchor-button text="Save and continue"
                                 url="@Model.OnwardLink"
                                 type="Primary" /> 
    </div>
</div>
