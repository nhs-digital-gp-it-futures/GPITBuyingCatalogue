@using NHSD.GPIT.BuyingCatalogue.ServiceContracts.Enums
@using NHSD.GPIT.BuyingCatalogue.ServiceContracts.Routing
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Controllers.SolutionSelection
@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.SolutionSelection.TaskList.TaskListOrderItemModel;
@{
    var progress = 0;
    if (Model.PriceStatus is not (TaskProgress.NotStarted or TaskProgress.CannotStart))
    {
        progress++;
    }
    if (Model.QuantityStatus is not (TaskProgress.NotStarted or TaskProgress.CannotStart))
    {
        progress++;
    }
    if (Model.AssociatedServicesStatus is TaskProgress.Completed)
    {
        progress++;
    }

    var marginBottom = (Model.CanBeRemoved ? "16px" : "48px");
}

<div style="display:block; align-items:center;">
    <h3 class="header-with-detail">
        @Model.Name
    </h3>
    @if(!Model.IsAmendment)
    {
        var progressEnd = Model.AssociatedServicesCatalogueItemsCount > 0 ? '3' : '2';
        <span class="detail">
            <strong>@progress</strong> of <strong>@progressEnd</strong> started
        </span>
    }
</div>

<nhs-table style="margin-bottom:@marginBottom">
    <nhs-table-column>Section</nhs-table-column>
    <nhs-table-column>Status</nhs-table-column>
    <nhs-table-column><span class="nhsuk-u-visually-hidden">Action</span></nhs-table-column>

    <nhs-table-row-container>
        <nhs-table-cell>Price</nhs-table-cell>
        <nhs-table-cell>
            <nhs-tag status-enum="@Model.PriceStatus" />
        </nhs-table-cell>
        <nhs-table-cell>
            @if (Model.NumberOfPrices == 1 && Model.PriceStatus == TaskProgress.NotStarted)
            {
                <a id="Price_@Model.CatalogueItemId" style="float:right;"
                    href="@Url.Action(
                                nameof(PricesController.ConfirmPrice),
                                typeof(PricesController).ControllerName(),
                                new { Model.InternalOrgId, Model.CallOffId, Model.CatalogueItemId, Model.PriceId, Model.OrderItemId, Model.Source })">Start</a>
            }
            else
            {
                string actionName, actionText;
                if (Model.IsAmendment && Model.FromPreviousRevision)
                {
                    (actionName, actionText) = (nameof(PricesController.ViewPrice), "View");
                }
                else
                {
                    (actionName, actionText) = Model.PriceStatus == TaskProgress.Completed ?
                        (nameof(PricesController.EditPrice), "Change") :
                        (nameof(PricesController.SelectPrice), "Start");
                }
                <a id="Price_@Model.CatalogueItemId" style="float:right;"
                    href="@Url.Action(
                                actionName,
                                typeof(PricesController).ControllerName(),
                                new { Model.InternalOrgId, Model.CallOffId, Model.CatalogueItemId, Model.OrderItemId, Model.Source })">@actionText</a>
            }
        </nhs-table-cell>
    </nhs-table-row-container>

    <nhs-table-row-container>
        <nhs-table-cell>Quantity</nhs-table-cell>
        <nhs-table-cell>
            <nhs-tag status-enum="@Model.QuantityStatus" />
        </nhs-table-cell>
        <nhs-table-cell>
            @if (Model.QuantityStatus != TaskProgress.CannotStart)
            {
                @if (Model.IsAmendment
                     && Model.QuantityStatus != TaskProgress.InProgress && Model.QuantityStatus != TaskProgress.NotStarted && !Model.HasNewRecipients && Model.FromPreviousRevision)
                {
                    var viewAction = Model.IsAssociatedService
                        ? Url.Action(
                            nameof(QuantityController.ViewServiceRecipientQuantity),
                            typeof(QuantityController).ControllerName(),
                            new { Model.InternalOrgId, Model.CallOffId, Model.CatalogueItemId, Model.OrderItemId, Model.QuantityViewCallOffId, Model.Source })
                        : Url.Action(
                            nameof(QuantityController.ViewServiceRecipientQuantity),
                            typeof(QuantityController).ControllerName(),
                            new { Model.InternalOrgId, Model.CallOffId, Model.CatalogueItemId, Model.OrderItemId, Model.Source });
                    <a id="Quantity_@Model.CatalogueItemId" style="float:right;"
                       href="@viewAction">View</a>
                }
                else
                {
                    var action = Model.QuantityStatus switch
                    {
                        TaskProgress.Completed => Model.OrderType.MergerOrSplit ? "View" : "Change",
                        TaskProgress.Amended => "Change",
                        TaskProgress.InProgress => "Change",
                        _ => "Start",
                    };

                    <a id="Quantity_@Model.CatalogueItemId" style="float:right;"
                       href="@Url.Action(
                                 nameof(QuantityController.SublocationHub),
                                 typeof(QuantityController).ControllerName(),
                                 new { Model.InternalOrgId, Model.CallOffId, Model.CatalogueItemId, Model.OrderItemId, Model.Source })">@action</a>
                }
            }
        </nhs-table-cell>
    </nhs-table-row-container>
    
    @if (Model.AssociatedServicesCatalogueItemsCount > 0)
    {
        <nhs-table-row-container>
            <nhs-table-cell>Associated Services</nhs-table-cell>
            <nhs-table-cell>
                <nhs-tag status-enum="@Model.AssociatedServicesStatus" />
            </nhs-table-cell>
            <nhs-table-cell>
                @{
                    string actionText = null;
                    string action = null;
                    if (Model.QuantityStatus is TaskProgress.Completed or TaskProgress.Amended || Model.IsAmendment && Model.QuantityStatus is TaskProgress.NotStarted)
                    {
                        (actionText, action) = Model.AssociatedServicesStatus switch
                        {
                            TaskProgress.Completed or TaskProgress.InProgress or TaskProgress.Amended => ("Change", nameof(AssociatedServicesController.ManageAssociatedServices)),
                            TaskProgress.NotStarted => ("Start", nameof(AssociatedServicesController.SelectAssociatedServices)),
                            _ => (null, null),
                        };
                    }
                    if (Model.AssociatedServicesStatus == TaskProgress.Completed && !Model.HasNewRecipients && Model.FromPreviousRevision)
                        actionText = "View";
                    
                    <a id="AssociatedServices_@Model.CatalogueItemId" style="float:right;"
                       href="@Url.Action(
                                 action, 
                                 typeof(AssociatedServicesController).ControllerName(),
                                 new { Model.InternalOrgId, Model.CallOffId, Model.CatalogueItemId })">@actionText</a>
                }
            </nhs-table-cell>
        </nhs-table-row-container>
    }
</nhs-table>

@if (Model.CanBeRemoved)
{
    <vc:nhs-delete-button url="@Url.Action(nameof(CatalogueSolutionsController.RemoveService),
        typeof(CatalogueSolutionsController).ControllerName(),
        new { Model.InternalOrgId, Model.CallOffId, orderItemId = Model.OrderItemId, source = Model.Source })"
        text="Remove @Model.Name" />
    <hr class="nhsuk-section-break nhsuk-section-break--m nhsuk-section-break--visible">
}
