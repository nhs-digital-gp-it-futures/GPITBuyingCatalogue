@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.Contracts.DeliveryDates.SelectDateModel
@{
    ViewBag.Title = "Planned delivery date";
}

@{
    var deliveryDateInPast = DateTime.UtcNow > Model.ExistingDeliveryDate;

    var plannedDeliveryDateText = deliveryDateInPast ? "The planned delivery date for the original order was" : "The planned delivery date for the original order is";
}

<partial name="Partials/_BackLink" model="Model" />

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
        <nhs-validation-summary RadioId="@nameof(Model.ApplyToAll)" />

        <nhs-page-title title="@ViewBag.Title"
                        caption="Order @Model.CallOffId"
                        advice="Enter the date organisations will start using these solutions and services" />

        @if (Model.IsAmend)
        {
            <nhs-inset-text>@plannedDeliveryDateText @Model.ExistingDeliveryDate?.ToString("d MMM yyyy")</nhs-inset-text>
        }

        <form method="post">
            <input type="hidden" asp-for="@Model.BackLink" />
            <input type="hidden" asp-for="@Model.ExistingDeliveryDate" />
            <input type="hidden" asp-for="@Model.CommencementDate"/>
            <input type="hidden" asp-for="@Model.MaximumTerm" />
            <input type="hidden" asp-for="@Model.IsAmend" />

            <div class="nhsuk-u-margin-bottom-9">
                <nhs-fieldset-form-label asp-for="@Model"
                                         label-text="What is the planned delivery date?"
                                         label-hint="If you have more than one, enter the date most organisations start using these solutions and services"
                                         size="Small">
                    <nhs-date-input asp-for="@Model" day="Day" month="Month" year="Year" show-example-text="true" />
                </nhs-fieldset-form-label>

                <nhs-fieldset-form-label asp-for="ApplyToAll"
                                         label-text="Do you want to use the same delivery date for all organisations?"
                                         size="Small">
                    <legend name="same delivery date"></legend>
                    <nhs-radio-buttons asp-for="ApplyToAll"
                                       values="@Model.ApplyToAllOptions.Cast<object>()"
                                       value-name="Value"
                                       display-name="Text"/>
                </nhs-fieldset-form-label>
            </div>

            <nhs-submit-button />
        </form>
    </div>
</div>
