@using System.Linq
@using NHSD.GPIT.BuyingCatalogue.EntityFramework.Ordering.Models;
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Controllers
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.Shared
@using NHSD.GPIT.BuyingCatalogue.WebApp.Models.Shared
@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.Orders.SummaryModel;
@{
    ViewBag.Title = Model.Title;
}

<partial name="Partials/_BackLink" model="Model" />

@{
    var solutions = Model.Order.GetSolutions().ToList();
    var additionalServices = Model.Order.GetAdditionalServices().ToList();
    var associatedServices = Model.Order.GetAssociatedServices().ToList();

    var orderSolution = Model.Order.OrderType.AssociatedServicesOnly ? Model.Order.AssociatedServicesOnlyDetails.Solution : Model.Order.GetSolutionOrderItem()?.CatalogueItem;
    var frameworks = orderSolution != null ? orderSolution?.Solution?.FrameworkSolutions?.Select(x => x.Framework).Distinct().ToList() : Enumerable.Empty<NHSD.GPIT.BuyingCatalogue.EntityFramework.Catalogue.Models.Framework>().ToList();

    var totalDisplayed = false;
    var caption = Model.Order.OrderType.MergerOrSplit && associatedServices.Count == 1
        ? associatedServices.First().CatalogueItem.Name
        : $"{Model.Order.CallOffId}";

    var editOrderDetailsLink = Url.Action(nameof(OrderController.Order), typeof(OrderController).ControllerName(), new { Model.InternalOrgId, Model.CallOffId });
    var editMilestonesAndPaymentTriggersLink = Url.Action(nameof(OrderController.Order), typeof(OrderController).ControllerName(), new { Model.InternalOrgId, Model.CallOffId });
}

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-full">
        <nhs-validation-summary />
        <nhs-page-title title="@ViewBag.Title"
                        caption="@caption" />

        @if (frameworks.Any(x => x.IsExpired))
        {
            <partial name="Partials/_ExpiredFrameworks" model="new ExpiredFrameworksModel(frameworks)" />
        }

        <p class="nhsuk-lede-text allow-paragraph-spacing">@Model.AdviceText</p>

        @if (Model.HasSubsequentRevisions)
        {
            <nhs-inset-text>
                <p>
                    You cannot terminate this contract as there is currently an amendment in progress.
                    You must <a href="@Url.Action(nameof(DashboardController.Index),
                                              typeof(DashboardController).ControllerName(),
                                              new { Model.InternalOrgId, Model.CallOffId })">cancel the amendment for Order @Model.CallOffId</a> before you can terminate this contract.
                </p>
            </nhs-inset-text>
        }

        <nhs-expander-v2 open="true">
            <nhs-expander-summary label-text="Order details" bold-title="true"></nhs-expander-summary>
            <nhs-expander-content>
                <nhs-table label-text="Order details">
                    <nhs-table-column>Property</nhs-table-column>
                    <nhs-table-column>Value</nhs-table-column>
                    @if(Model.CanBeAmended){<nhs-table-column><span class="nhsuk-u-visually-hidden">Action</span></nhs-table-column>}

                    <nhs-table-row-container data-test-id="date-created-summary">
                        <nhs-table-row-header-cell>Date created</nhs-table-row-header-cell>
                        <nhs-table-cell>@($"{Model.Order.Created:d MMMM yyyy}")</nhs-table-cell>
                        @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell><span class="nhsuk-u-visually-hidden">No action for this row</span></nhs-table-cell>
                            }
                    </nhs-table-row-container>

                    <nhs-table-row-container data-test-id="order-id-summary">
                        <nhs-table-row-header-cell>Order ID</nhs-table-row-header-cell>
                        <nhs-table-cell>@Model.Order.CallOffId</nhs-table-cell>
                        @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell><span class="nhsuk-u-visually-hidden">No action for this row</span></nhs-table-cell>
                            }
                    </nhs-table-row-container>

                    <nhs-table-row-container data-test-id="order-description-summary">
                        <nhs-table-row-header-cell>Description</nhs-table-row-header-cell>
                        <nhs-table-cell>@Model.Order.Description</nhs-table-cell>
                        @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell>
                                    <a title="Change order description" class="nhsuk-link nhsuk-link--no-visited-state" data-test-id="change-order-description"
                                       asp-action="@nameof(OrderDescriptionController.OrderDescription)"
                                       asp-controller="@typeof(OrderDescriptionController).ControllerName()"
                                       asp-route-internalOrgId="@Model.InternalOrgId"
                                       asp-route-callOffId="@Model.Order.CallOffId">Change</a>
                                </nhs-table-cell>
                            }
                    </nhs-table-row-container>

                    @if (Model.Order.OrderingPartyContact != null)
                    {
                        <nhs-table-row-container data-test-id="ordering-party-contact">
                            <nhs-table-row-header-cell>Primary contact</nhs-table-row-header-cell>
                            <nhs-table-cell>
                                @($"{Model.Order.OrderingPartyContact.FirstName} {Model.Order.OrderingPartyContact.LastName}")<br/>
                                @($"{Model.Order.OrderingPartyContact.Email}")<br />
                            </nhs-table-cell>
                            @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell>
                                    <a title="Change ordering party contact" class="nhsuk-link nhsuk-link--no-visited-state" data-test-id="change-order-ordering-party-contact"
                                       asp-action="@nameof(OrderingPartyController.OrderingParty)"
                                       asp-controller="@typeof(OrderingPartyController).ControllerName()"
                                       asp-route-internalOrgId="@Model.InternalOrgId"
                                       asp-route-callOffId="@Model.Order.CallOffId">Change</a></nhs-table-cell>
                            }
                        </nhs-table-row-container>
                    }

                    @if (Model.Order.OrderingParty != null)
                    {
                        <nhs-table-row-container data-test-id="ordering-party-summary">
                            <nhs-table-row-header-cell>Call-off ordering party</nhs-table-row-header-cell>
                            <nhs-table-cell>
                                @Model.Order.OrderingParty.Name<br/>
                                @Model.Order.OrderingParty.ExternalIdentifier<br/>
                                <vc:nhs-address address="@Model.Order.OrderingParty.Address"/>
                            </nhs-table-cell>
                            @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell><span class="nhsuk-u-visually-hidden">No action for this row</span></nhs-table-cell>
                            }
                        </nhs-table-row-container>
                    }

                    @if (Model.Order.SupplierContact != null)
                    {
                        <nhs-table-row-container data-test-id="supplier-contact">
                            <nhs-table-row-header-cell>Supplier contact</nhs-table-row-header-cell>
                            <nhs-table-cell>
                                @($"{Model.Order.SupplierContact.NameOrDepartment}")<br/>
                                @($"{Model.Order.SupplierContact.Email}")<br />
                            </nhs-table-cell>
                            @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell>
                                    <a title="Change supplier contact" class="nhsuk-link nhsuk-link--no-visited-state" data-test-id="change-order-supplier-contact"
                                       asp-action="@nameof(SupplierController.Supplier)"
                                       asp-controller="@typeof(SupplierController).ControllerName()"
                                       asp-route-internalOrgId="@Model.InternalOrgId"
                                       asp-route-callOffId="@Model.Order.CallOffId">Change</a></nhs-table-cell>
                            }
                        </nhs-table-row-container>
                    }

                    @if (Model.Order.Supplier != null)
                    {
                        @if (!string.Equals(Model.Order.Supplier.LegalName, Model.Order.Supplier.Name, StringComparison.OrdinalIgnoreCase))
                        {
                            <nhs-table-row-container data-test-id="supplier-legal-name">
                                <nhs-table-row-header-cell>Supplier legal name</nhs-table-row-header-cell>
                                <nhs-table-cell>@Model.Order.Supplier.LegalName</nhs-table-cell>
                                @if (Model.CanBeAmended)
                                {
                                    <nhs-table-cell><span class="nhsuk-u-visually-hidden">No action for this row</span></nhs-table-cell>
                                }
                            </nhs-table-row-container>
                        }

                        <nhs-table-row-container data-test-id="supplier-summary">
                            <nhs-table-row-header-cell>Supplier</nhs-table-row-header-cell>
                            <nhs-table-cell>
                                @Model.Order.Supplier.Name<br/>
                                <vc:nhs-address address="@Model.Order.Supplier.Address"/>
                            </nhs-table-cell>
                            @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell><span class="nhsuk-u-visually-hidden">No action for this row</span></nhs-table-cell>
                            }
                        </nhs-table-row-container>
                    }

                    @if (Model.Order.CommencementDate.HasValue)
                    {
                        <nhs-table-row-container data-test-id="start-date-summary">
                            <nhs-table-row-header-cell>Commencement date</nhs-table-row-header-cell>
                            <nhs-table-cell>@($"{Model.Order.CommencementDate.Value:d MMMM yyyy}")</nhs-table-cell>
                            @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell><span class="nhsuk-u-visually-hidden">No action for this row</span></nhs-table-cell>
                            }
                        </nhs-table-row-container>
                    }

                    @if (Model.Order.InitialPeriod.HasValue)
                    {
                        <nhs-table-row-container data-test-id="initial-period-summary">
                            <nhs-table-row-header-cell>Initial period</nhs-table-row-header-cell>
                            <nhs-table-cell>@($"{Model.Order.InitialPeriod} months")</nhs-table-cell>
                            @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell><span class="nhsuk-u-visually-hidden">No action for this row</span></nhs-table-cell>
                            }
                        </nhs-table-row-container>
                    }

                    @if (Model.Order.MaximumTerm.HasValue)
                    {
                        <nhs-table-row-container data-test-id="maximum-term-summary">
                            <nhs-table-row-header-cell>Maximum term</nhs-table-row-header-cell>
                            <nhs-table-cell>@($"{Model.Order.MaximumTerm} months")</nhs-table-cell>
                            @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell><span class="nhsuk-u-visually-hidden">No action for this row</span></nhs-table-cell>
                            }
                        </nhs-table-row-container>
                    }

                    @if (Model.Order.CommencementDate.HasValue
                         && Model.Order.MaximumTerm.HasValue)
                    {
                        <nhs-table-row-container data-test-id="end-date-summary">
                            <nhs-table-row-header-cell>End date</nhs-table-row-header-cell>
                            <nhs-table-cell>@Model.Order.EndDate.DisplayValue</nhs-table-cell>
                            @if (Model.CanBeAmended)
                            {
                                <nhs-table-cell><span class="nhsuk-u-visually-hidden">No action for this row</span></nhs-table-cell>
                            }
                        </nhs-table-row-container>
                    }
                </nhs-table>
            </nhs-expander-content>
            @if (Model.Order.OrderStatus == OrderStatus.InProgress)
            {
                <nhs-expander-footer>
                    <vc:add-or-change href="@editOrderDetailsLink" noun-phrase="order details" is-change="true" custom-verb="Edit"/>
                </nhs-expander-footer>
            }
        </nhs-expander-v2>

        @if (Model.Order.OrderStatus == OrderStatus.Terminated)
        {
            <h2>Termination details</h2>
            <nhs-card-v2>
            <nhs-card-content>

                <nhs-summary-list>
                    <nhs-summary-list-row label-text="Reason for termination" data-test-id="termination-reason-summary">
                        @Model.Order.OrderTermination.Reason
                    </nhs-summary-list-row>

                    <nhs-summary-list-row label-text="Date of termination" data-test-id="termination-date-summary">
                        @($"{Model.Order.OrderTermination.DateOfTermination:d MMMM yyyy}")
                    </nhs-summary-list-row>

                </nhs-summary-list>
            </nhs-card-content>
            </nhs-card-v2>
        }

        @if (!(Model.Order.OrderItems?.Any() ?? false))
        {
            <p>No items have been added to this order yet</p>
        }
        else
        {
            <br />
            @if (solutions.Any())
            {
                <h2 id="catalogue-solutions-title">Catalogue solution details</h2>
                @foreach (var solution in solutions)
                {
                    var itemModel = Model.BuildAmendOrderItemModel(solution);
                    <partial name="_OrderItemSummary" model="@itemModel" />
                }
            }

            @if (additionalServices.Any())
            {
                var heading = additionalServices.Count == 1
                ? "Additional service"
                : "Additional services";

                <h2 id="additional-services-title">@heading details</h2>
                @foreach (var additionalService in additionalServices)
                {
                    var itemModel = Model.BuildAmendOrderItemModel(additionalService);
                    <partial name="_OrderItemSummary" model="@itemModel" />
                    
                    @if (Model.AssociatedServicesForAdditionalServices.ContainsKey(additionalService.Id))
                    {
                        var headingText = $"{additionalService.CatalogueItem.Name} - Associated Service details";
                        <h3>@headingText</h3>
                        @foreach (var associatedService in Model.AssociatedServicesForAdditionalServices[additionalService.Id])
                        {
                            var associatedServiceModel = Model.BuildAmendOrderItemModel(associatedService, additionalService.CatalogueItem.Name);
                            <partial name="_OrderItemSummary" model="@associatedServiceModel" />
                        }
                    }
                    
                    @if (Model.PreviousAssociatedServicesForAdditionalServices.ContainsKey(additionalService.CatalogueItemId))
                    {
                        <h3>Previously ordered associated services</h3>
                        @foreach (var group in Model.PreviousAssociatedServicesForAdditionalServices[additionalService.CatalogueItemId].Reverse())
                        {
                            <nhs-expander-v2 open="true">
                                <nhs-expander-summary label-text="@group.Key" bold-title="true"></nhs-expander-summary>
                                <nhs-expander-content>
                                    @foreach (var associatedService in group.Value)
                                    {
                                        var previousServiceModel = Model.BuildAmendOrderItemModel(associatedService, additionalService.CatalogueItem.Name, true);
                                        previousServiceModel.IsCardView = true;
                                        previousServiceModel.IsAmendment = true;
                                        <partial name="_OrderItemSummary" model="@previousServiceModel" />
                                    }
                                </nhs-expander-content>
                            </nhs-expander-v2>
                        }
                    }
                }
            }

            @if (solutions.Any() || additionalServices.Any())
            {
                <h2 id="milestones-title">Milestones and payment triggers for catalogue solution and additional services</h2>

                <nhs-expander-v2 open="true">
                    <nhs-expander-summary label-text="Milestones and payment triggers" bold-title="true"></nhs-expander-summary>
                    <nhs-expander-content>
                        <div class="nhsuk-u-margin-bottom-9">
                            <partial name="MilestoneTable" model="new MilestoneTableModel(Model.DefaultMilestoneLabelText, Model.DefaultPlan?.Milestones, false, Model.CallOffId, Model.InternalOrgId)" />
                        </div>

                        @if (Model.HasBespokeMilestones)
                        {
                            <partial name="MilestoneTable" model="new MilestoneTableModel(Model.BespokeMilestoneLabelText, Model.BespokePlan.Milestones, false, Model.CallOffId, Model.InternalOrgId)" />
                        }
                        else
                        {
                            <h3>@Model.BespokeMilestoneLabelText</h3>
                            <p>No bespoke milestones have been added for catalogue solution or additional services.</p>
                        }
                    </nhs-expander-content>
                    @if (Model.Order.OrderStatus == OrderStatus.InProgress)
                    {
                        <nhs-expander-footer>
                            <vc:add-or-change href="@editMilestonesAndPaymentTriggersLink" noun-phrase="milestones and payment triggers" is-change="true" custom-verb="Edit"/>
                        </nhs-expander-footer>
                    }
                </nhs-expander-v2>
            }

            @if (associatedServices.Any() || Model.PreviousAssociatedServicesGrouping.Any())
            {
                var heading = associatedServices.Count == 1
                ? "Associated service"
                : "Associated services";
                var solutionName = solutions.FirstOrDefault()?.CatalogueItem.Name;

                <h2 id="associated-services-title">@heading details</h2>
                @if (Model.AssociatedServicesCurrentOrder.Any())
                {
                    var associatedServicesForCurrentOrder = Model.AssociatedServicesCurrentOrder.ToList();
                    <h3>Associated Services for this order</h3>
                    @foreach (var associatedService in associatedServicesForCurrentOrder)
                    {
                        var itemModel = Model.BuildAmendOrderItemModel(associatedService, solutionName);
                        if (Model.Order.OrderType.MergerOrSplit)
                        {
                            if (associatedServicesForCurrentOrder.Count == 1)
                            {
                                totalDisplayed = true;
                                itemModel.OrderTotals = Model.BuildOrderTotals();
                            }
                        }
                        <partial name="_OrderItemSummary" model="@itemModel" />
                    }
                }
                
                @if (Model.PreviousAssociatedServicesGrouping.Any())
                {
                    <h3>Previously ordered associated services</h3>
                    @foreach (var group in Model.PreviousAssociatedServicesGrouping.Reverse())
                    {
                        <nhs-expander-v2 open="true">
                            <nhs-expander-summary label-text="@group.Key" bold-title="true"></nhs-expander-summary>
                            <nhs-expander-content>
                                @foreach (var associatedService in group)
                                {
                                    var itemModel = Model.BuildAmendOrderItemModel(associatedService, solutionName, true);
                                    itemModel.IsCardView = true;
                                    itemModel.IsAmendment = true;
                                    <partial name="_OrderItemSummary" model="@itemModel" />
                                }
                            </nhs-expander-content>
                        </nhs-expander-v2>
                    }
                }

                <h2 id="as-milestones-title">Milestones and payment triggers for associated services</h2>

                <nhs-expander-v2 open="true">
                <nhs-expander-summary label-text="Milestones and payment triggers" bold-title="true"></nhs-expander-summary>
                <nhs-expander-content>
                    <h3>Default milestones and payment triggers</h3>

                    <p>
                        The default milestone for an associated service is the completion of its delivery. This will trigger the payment process.
                        However, you can add bespoke milestones to act as payment triggers for this order, but they must be agreed with the supplier.
                    </p>
                    <p>
                        The default milestone will apply to any associated services not assigned a bespoke milestone.
                    </p>

                    @if (Model.HasBespokeBilling)
                    {
                        <partial name="ContractBillingItemTable" model="new ContractBillingItemTableModel(Model.BespokeBillingLabelText, Model.BespokeBilling.ContractBillingItems, false, Model.CallOffId, Model.InternalOrgId)" />
                    }
                    else
                    {
                        <h3>@Model.BespokeBillingLabelText</h3>
                        <p>No bespoke milestones have been added for associated services.</p>
                    }

                    <h3 id="requirements-title">Associated service specific requirements</h3>
                    @if (Model.HasSpecificRequirements)
                    {
                        <partial name="RequirementTable" model="new RequirementTableModel(Model.RequirementLabelText, Model.BespokeBilling.Requirements, false, Model.CallOffId, Model.InternalOrgId)" />
                    }
                    else
                    {
                        <p>No specific requirements have been added for associated services.</p>
                    }
                </nhs-expander-content>
                    @if (Model.Order.OrderStatus == OrderStatus.InProgress)
                {
                    <nhs-expander-footer>
                            <vc:add-or-change href="@editMilestonesAndPaymentTriggersLink" noun-phrase="milestones and payment triggers" is-change="true" custom-verb="Edit" />
                    </nhs-expander-footer>
                }
                </nhs-expander-v2>
            }

                <h2>Data processing information</h2>
                <nhs-card-v2>
                    <nhs-card-content>
                        <p id="bespoke-data-processing">
                            Data processing information will be captured in a separate template
                            that must be included with this order. <a href="https://gpitbjss.atlassian.net/wiki/spaces/BG/pages/12207980954/Order+form+template+Data+processing+information" target="_blank">Download data processing template (opens in a new tab)</a>
                        </p>
                    </nhs-card-content>
                </nhs-card-v2>

            @if (totalDisplayed == false)
            {
                <h2 id="costs-title">Cost of order</h2>
                   <nhs-card-v2>
                       <nhs-card-content title="Total indicative costs excluding VAT">
                           @if (Model.Order.IsAmendment)
                           {
                           <nhs-table id="review-solutions-amended-indicative-costs">
                               <nhs-table-column>Cost type</nhs-table-column>
                               <nhs-table-column numeric="true">Previous cost</nhs-table-column>
                               <nhs-table-column numeric="true">Difference</nhs-table-column>
                               <nhs-table-column numeric="true">New cost</nhs-table-column>
                               <nhs-table-row-container>
                                   <nhs-table-cell>
                                       <strong>Total one-off cost:</strong>
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.Previous.TotalOneOffCost(null, true):N2}")
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.RolledUp.TotalOneOffCost(null, true) - Model.Previous.TotalOneOffCost(null, true):N2}")
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.RolledUp.TotalOneOffCost(null, true):N2}")
                                   </nhs-table-cell>
                               </nhs-table-row-container>
                               <nhs-table-row-container>
                                   <nhs-table-cell>
                                       <strong>Total monthly cost:</strong>
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.Previous.TotalMonthlyCost(null, true):N2}")
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.RolledUp.TotalMonthlyCost(null, true) - Model.Previous.TotalMonthlyCost(null, true):N2}")
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.RolledUp.TotalMonthlyCost(null, true):N2}")
                                   </nhs-table-cell>
                               </nhs-table-row-container>
                               <nhs-table-row-container>
                                   <nhs-table-cell>
                                       <strong>Total cost for one year:</strong>
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.Previous.TotalAnnualCost(null, true):N2}")
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.RolledUp.TotalAnnualCost(null, true) - Model.Previous.TotalAnnualCost(null, true):N2}")
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.RolledUp.TotalAnnualCost(null, true):N2}")
                                   </nhs-table-cell>
                               </nhs-table-row-container>
                               <nhs-table-row-container>
                                   <nhs-table-cell>
                                       <strong>Total cost of contract:</strong>
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.OrderWrapper.TotalPreviousCost(true):N2}")
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.OrderWrapper.TotalCost(true) - Model.OrderWrapper.TotalPreviousCost(true):N2}")
                                   </nhs-table-cell>
                                   <nhs-table-cell numeric="true">
                                       £@($"{Model.OrderWrapper.TotalCost(true):N2}")
                                   </nhs-table-cell>
                               </nhs-table-row-container>
                           </nhs-table>
                           }
                           else
                           {
                               var totalModel = Model.BuildOrderTotals();
                               <partial name="_OrderTotal" model="@totalModel" />
                           }
                       </nhs-card-content>
                   </nhs-card-v2>
            }
        }

        <div class="nhsuk-u-margin-top-3">
            <h2>@Model.ButtonLabelText</h2>
            <p>@Model.ButtonAdviceText</p>

            <form method="post">
                <nhs-button-group>
                    @if (Model.Order.OrderStatus == OrderStatus.InProgress)
                    {
                        if (Model.OrderWrapper.CanComplete())
                        {
                            <nhs-submit-button text="Complete order"/>
                        }
                        else
                        {
                            <vc:nhs-anchor-button text="Save and continue"
                                                     type="Primary"
                                                     url="@Url.Action(nameof(OrderController.Order), typeof(OrderController).ControllerName(), new { Model.InternalOrgId, Model.CallOffId })"/>
                        }
                    }

                    <vc:nhs-anchor-button text="Download Order Summary (PDF)"
                                             type="Secondary"
                                             url="@Url.Action(nameof(OrderController.Download), typeof(OrderController).ControllerName(), new { Model.InternalOrgId, Model.CallOffId })"/>


                    @if (Model.CanBeAmended)
                    {
                        <vc:nhs-anchor-button text="Amend contract"
                                                 type="Secondary"
                                                 url="@Url.Action(nameof(OrderController.AmendOrder), typeof(OrderController).ControllerName(), new { Model.InternalOrgId, Model.CallOffId })"/>
                    }

                    @if (Model.CanBeTerminated)
                    {
                        <vc:nhs-delete-button url="@Url.Action(nameof(OrderController.TerminateOrder), typeof(OrderController).ControllerName(), new { Model.InternalOrgId, Model.CallOffId })" text="Terminate contract"/>
                    }

                    @if (Model.OrderWrapper.CanComplete())
                    {
                        <a class="nhsuk-link nhsuk-link--no-visited-state" href="@Url.Action(nameof(DashboardController.Organisation), typeof(DashboardController).ControllerName(), new { Model.InternalOrgId })">Save for later</a>
                    }
                </nhs-button-group>

                @if (Model.Order.OrderStatus != OrderStatus.InProgress)
                {
                    <nhs-button-group>
                        <vc:nhs-anchor-button text="Return to orders"
                                                 type="Primary"
                                                 url="@Url.Action(nameof(DashboardController.Organisation), typeof(DashboardController).ControllerName(), new { Model.InternalOrgId })"/>
                    </nhs-button-group>
                }
            </form>
        </div>
    </div>
</div>
