@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Controllers
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.Orders;
@model AmendOrderItemModel

@{
    var editOrderDetailsLink = Url.Action(nameof(OrderController.Order), typeof(OrderController).ControllerName(), new { Model.InternalOrgId, Model.CallOffId });
}

@if (Model.IsCardView)
{
    <nhs-card-v2>
        <nhs-card-content title="@Model.ItemName">
            <partial name="_OrderItemSummaryContent" model="@Model"/>
        </nhs-card-content>
    </nhs-card-v2>
}

else
{
    <nhs-expander-v2 open="true">
        <nhs-expander-summary label-text="@Model.ItemName" bold-title="true"></nhs-expander-summary>
        <nhs-expander-content>
            <partial name="_OrderItemSummaryContent" model="@Model"/>
        </nhs-expander-content>
        @if (Model.CanEdit)
        {
            <nhs-expander-footer>
                <vc:add-or-change href="@editOrderDetailsLink" noun-phrase="details for @Model.CatalogueItem.Name" is-change="true" custom-verb="Edit" />
            </nhs-expander-footer>
        }
    </nhs-expander-v2>
}
