@using Microsoft.AspNetCore.Mvc.TagHelpers
@using NHSD.GPIT.BuyingCatalogue.EntityFramework.Catalogue.Models
@using NHSD.GPIT.BuyingCatalogue.EntityFramework.Extensions
@using NHSD.GPIT.BuyingCatalogue.EntityFramework.Interfaces
@using NHSD.GPIT.BuyingCatalogue.EntityFramework.Ordering.Models
@using NHSD.GPIT.BuyingCatalogue.UI.Components.Views.Shared.TagHelpers.DetailsAndExpander
@using NHSD.GPIT.BuyingCatalogue.UI.Components.Views.Shared.TagHelpers.Table
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Controllers
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.Orders;
@using NHSD.GPIT.BuyingCatalogue.WebApp.Extensions;
@model OrderItemRecipientRowModel

@{
    var quantity = Model.ServiceRecipient.GetQuantityForItem(Model.OrderItemId);
    var deliveryDate = Model.ServiceRecipient.GetDeliveryDateForItem(Model.OrderItemId);
    var deliveryDateText = deliveryDate.HasValue
        ? $"{deliveryDate.Value:d MMM yyyy}"
        : "No date entered";
    var itemRecipientId = Model.DisplayNumber is null 
        ? $"{Model.CallOffId}-{Model.ServiceRecipient.RecipientOdsCode}-{Model.CatalogueItemId}-{Model.OrderItemId}" 
        : $"{Model.CallOffId}-{Model.ServiceRecipient.RecipientOdsCode}-{Model.DisplayNumber}";
}

<td role="cell" class="nhsuk-table__cell">@Model.ServiceRecipient.RecipientOdsOrganisation?.Name (@Model.ServiceRecipient.RecipientOdsCode)</td>
<td role="cell" class="nhsuk-table__cell">@itemRecipientId</td>
<td role="cell" class="nhsuk-table__cell">@deliveryDateText</td>
<td role="cell" class="nhsuk-table__cell">
    @(quantity.HasValue ? $"{quantity:N0}" : "N/A")
</td>
@if (Model.IsAmendment)
{
    <td role="cell" class="nhsuk-table__cell" style="width: 50px;">
        <div class="bc-c-task-list__task-status">
            @if (!Model.FromPreviousRevision && Model.IsServiceRecipientAdded)
            {
                <strong class="nhsuk-tag nhsuk-tag--blue">Added</strong>
            }
            else
            {
                <strong class="nhsuk-tag nhsuk-tag--green">Completed</strong>
            }
        </div>
    </td>
}
