@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.Contracts.Requirement.RequirementDetailsModel
@{
    ViewBag.Title = Model.IsEdit
            ? "Edit associated service requirement"
            : "Add associated service requirement";
}
<partial name="Partials/_BackLink" model="Model"/>

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
        <nhs-validation-summary RadioId="@(nameof(Model.RequiresExplanation))"/>

        <nhs-page-title title="@ViewBag.Title"
                        caption="Order @Model.CallOffId"/>

        <form method="post">
            <input type="hidden" asp-for="BackLink"/>

            <nhs-select asp-for="SelectedOrderItemId"
                        asp-items="@Model.OrderItemOptions"
                        label-text="Select associated service"/>

            <nhs-textarea asp-for="Details"
                          label-text="Describe your specific requirements for this associated service" />


            <nhs-fieldset-form-label asp-for="@Model" label-text="Do you want the supplier to explain how their service meets your needs?" size="Small">
                <nhs-radio-buttons asp-for="RequiresExplanation"
                                   values="@Model.Explanations.Cast<object>()"
                                   value-name="Value"
                                   display-name="Text" />
            </nhs-fieldset-form-label>

            <nhs-button-group>
                <nhs-submit-button text="Save and continue"/>
            </nhs-button-group>
        </form>
    </div>
</div>
