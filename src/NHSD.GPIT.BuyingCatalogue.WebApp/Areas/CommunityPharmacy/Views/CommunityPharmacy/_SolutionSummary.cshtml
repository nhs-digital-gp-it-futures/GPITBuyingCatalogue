@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.CommunityPharmacy.Models.CommunityPharmacySolutionDisplayBaseModel
<nhs-summary-list>
    <nhs-summary-list-row label-text="Solution name">
        <p>@Model.SolutionName</p>
    </nhs-summary-list-row>
    <nhs-summary-list-row label-text="Supplier name">
        <p>
            @Model.SupplierName
        </p>
    </nhs-summary-list-row>
    <nhs-summary-list-row label-text="Solution ID">
        <p>
            @Model.SolutionId
        </p>
    </nhs-summary-list-row>
</nhs-summary-list>


