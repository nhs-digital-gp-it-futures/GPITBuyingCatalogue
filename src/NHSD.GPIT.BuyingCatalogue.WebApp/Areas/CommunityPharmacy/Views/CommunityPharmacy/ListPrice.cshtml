@using NHSD.GPIT.BuyingCatalogue.EntityFramework.Extensions
@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.CommunityPharmacy.Models.CommunityPharmacyListPriceModel

<partial name="_SolutionSummary" model="Model" />

<div class="nhsuk-u-margin-top-5" aria-labelledby="flat-prices-heading">
    <h2 id="flat-prices-heading">Flat prices for this pharmacy solution</h2>
    @foreach (var listPrice in Model.ListPrices)
    {
        var individualPrice = listPrice.CataloguePriceTiers.ElementAt(0);
        <nhs-card>
            <div class="community-pharmacy-pricing__table">
                <nhs-table>
                    <nhs-table-row-container>
                        <nhs-table-cell>Price</nhs-table-cell>
                        <nhs-table-cell>
                            <strong class="nhsuk-u-font-size-19">£@individualPrice.Price.ToString("N2") @listPrice.PricingUnit.Description</strong>
                        </nhs-table-cell>
                    </nhs-table-row-container>
                    <nhs-table-row-container>
                        <nhs-table-cell>Price type</nhs-table-cell>
                        <nhs-table-cell>Flat price</nhs-table-cell>
                    </nhs-table-row-container>
                    <nhs-table-row-container>
                        <nhs-table-cell>Provisioning type</nhs-table-cell>
                        <nhs-table-cell>
                            @listPrice.ProvisioningType.Name()
                        </nhs-table-cell>
                    </nhs-table-row-container>
                </nhs-table>
            </div>
            <p class="community-pharmacy-pricing__disclaimer nhsuk-body-s nhsuk-u-margin-top-3 nhsuk-u-margin-bottom-0">
                <em>Prices are exclusive of VAT. Final pricing may vary based on volume and contract terms.</em>
            </p>
        </nhs-card>
    }
</div>
