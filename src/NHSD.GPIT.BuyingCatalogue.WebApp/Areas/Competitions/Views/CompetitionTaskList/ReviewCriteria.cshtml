@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Competitions.Models.Shared
@model CompetitionReviewCriteriaModel

@{
    ViewBag.Title = "Review competition criteria";
    var editRouteValues = new { internalOrgId = Model.InternalOrgId, competitionId = Model.CompetitionId, returnUrl = Url.Action() };

    var editPriceWeightings = Url.Action(nameof(CompetitionTaskListController.Weightings), typeof(CompetitionTaskListController).ControllerName(), editRouteValues);
    var editNonPriceElementWeightings = Url.Action(nameof(CompetitionNonPriceElementsController.Weights), typeof(CompetitionNonPriceElementsController).ControllerName(), editRouteValues);
}

<partial name="Partials/_BackLink" model="Model"/>

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
        <nhs-validation-summary />
        <nhs-page-title title="@ViewBag.Title"
                        caption="@Model.CompetitionName"
                        advice="Review the weightings you’ve applied to your competition and the details of any non-price elements you’ve added."/>

        <h2 class="nhsuk-heading-l">Weightings</h2>
        <nhs-card-v2>
            <nhs-card-content title="Award criteria weighting">
                <nhs-summary-list>
                    <nhs-summary-list-row label-text="Price">@Model.CompetitionWeights.Price%</nhs-summary-list-row>
                    <nhs-summary-list-row label-text="Non-price">@Model.CompetitionWeights.NonPrice%</nhs-summary-list-row>
                </nhs-summary-list>
            </nhs-card-content>
            @if (!Model.HasReviewedCriteria)
            {
                <nhs-card-footer>
                    <vc:add-or-change href="@editPriceWeightings" noun-phrase="weightings" is-change="true" />
                </nhs-card-footer>
            }
        </nhs-card-v2>
        <nhs-card-v2>
            <nhs-card-content title="Non-price weighting">
            <nhs-summary-list>
                @foreach (var nonPriceWeighting in Model.NonPriceWeights)
                {
                    <nhs-summary-list-row label-text="@nonPriceWeighting.Key.ToString()">@nonPriceWeighting.Value%</nhs-summary-list-row>
                }
            </nhs-summary-list>
            </nhs-card-content>
            @if (!Model.HasReviewedCriteria)
            {
                <nhs-card-footer>
                    <vc:add-or-change href="@editNonPriceElementWeightings" noun-phrase="weightings" is-change="true" />
                </nhs-card-footer>
            }
        </nhs-card-v2>

        <h2 class="nhsuk-heading-l">Non-price elements</h2>
        <partial name="Partials/_NonPriceElements" model="@(new NonPriceElementsPartialModel(Model.InternalOrgId, Model.CompetitionId, Model.NonPriceElements, editRouteValues, Model.HasReviewedCriteria, Model.AvailableIntegrations))"/>
        <br/>

        <form method="post">
            <input type="hidden" asp-for="InternalOrgId" />
            <input type="hidden" asp-for="CompetitionId" />
            <input type="hidden" asp-for="CompetitionName" />
            <input type="hidden" asp-for="HasReviewedCriteria" />

            @if (!Model.HasReviewedCriteria)
            {
                <nhs-fieldset-form-label asp-for="@Model"
                                         label-text="Confirming competition criteria" label-hint="Confirming your competition criteria will mean you can no longer change the information you’ve provided. Both the award criteria and non-price elements you’ve selected will be locked, as will the weightings you’ve given for each of them. <br/>  <br/>If you’re happy with the information you can confirm your competition criteria and proceed." size="Small">
                    <nhs-checkbox-container>
                        <nhs-checkbox label-text="I confirm I want proceed with this competition criteria" asp-for="@Model.ConfirmCriteria" />
                    </nhs-checkbox-container>

                </nhs-fieldset-form-label>
            }

            <nhs-submit-button text="@Model.ContinueButton"/>
        </form>
    </div>
</div>
