@using NHSD.GPIT.BuyingCatalogue.UI.Components.Views.Shared.TagHelpers.Table
@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Competitions.Models.Shared.Partials.InteroperabilityPartialModel
<nhs-table>
    <nhs-table-column>Integration</nhs-table-column>
    <nhs-table-column>Type</nhs-table-column>
    @foreach (var integration in Model.AvailableIntegrations.OrderBy(x => x.Key))
    {
        var selectedIntegrationTypes = Model.IntegrationTypes.Where(x => x.IntegrationId == integration.Key).OrderBy(x => x.Name).ToList();

        <nhs-table-row-container>
            <nhs-table-cell style="word-break:break-all">
                @(integration.Value) integrations
            </nhs-table-cell>
            <nhs-table-cell>
                @if (!selectedIntegrationTypes.Any())
                {
                    <span>None selected</span>
                }
                else
                {
                    <ul>
                        @foreach (var selectedIntegration in selectedIntegrationTypes.OrderBy(x => x.Name))
                        {
                            <li>@selectedIntegration.Name</li>
                        }
                    </ul>
                }
            </nhs-table-cell>
        </nhs-table-row-container>
    }
</nhs-table>
              
