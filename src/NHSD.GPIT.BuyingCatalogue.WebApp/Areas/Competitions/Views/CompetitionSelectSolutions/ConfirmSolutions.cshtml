@using NHSD.GPIT.BuyingCatalogue.UI.Components.Views.Shared.TagHelpers.Table
@model ConfirmSolutionsModel

@{
    ViewBag.TItle = "Confirm shortlisted solutions";

    var changeShortlistedSolutionsLink = Url.Action(nameof(CompetitionSelectSolutionsController.SelectSolutions), typeof(CompetitionSelectSolutionsController).ControllerName(), new { Model.InternalOrgId, Model.CompetitionId });
    var changeJustificationsLink = Url.Action(nameof(CompetitionSelectSolutionsController.JustifySolutions), typeof(CompetitionSelectSolutionsController).ControllerName(), new { Model.InternalOrgId, Model.CompetitionId });
}

<partial name="Partials/_BackLink" model="Model"/>

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-full">
        <nhs-validation-summary/>
        <nhs-page-title title="@ViewBag.Title" caption="@Model.CompetitionName" advice="Review the solutions you’ve included in your shortlist and take them into a competition."/>
    
        <form method="post">
            <input type="hidden" asp-for="BackLink" />
            <nhs-card-v2>
                <nhs-card-content>
                    <nhs-table label-text="Your shortlisted solutions">
                        <nhs-table-column>Solution and supplier</nhs-table-column>
                        <nhs-table-column>Additional services required</nhs-table-column>

                        @foreach (var solution in Model.ShortlistedSolutions.OrderBy(x => x.CatalogueItem.Name))
                        {
                            <nhs-table-row-container>
                                <nhs-table-cell>
                                    @solution.CatalogueItem.Name
                                    <br/>
                                    <span class="nhsuk-caption-m nhsuk-caption--bottom">@solution.CatalogueItem.Supplier.LegalName</span>
                                </nhs-table-cell>
                                @if (solution.Services.Any())
                                {
                                    <nhs-table-cell>
                                        <ul>
                                            @foreach (var item in solution.Services)
                                            {
                                                <li>@item.CatalogueItem.Name</li>
                                            }
                                        </ul>
                                    </nhs-table-cell>
                                }
                                else
                                {
                                    <nhs-table-cell>None</nhs-table-cell>
                                }
                            </nhs-table-row-container>
                        }
                    </nhs-table>
                </nhs-card-content>
                <nhs-card-footer>
                    <vc:add-or-change href="@changeShortlistedSolutionsLink" noun-phrase="shortlisted solutions" is-change="true" />
                </nhs-card-footer>
            </nhs-card-v2>

            <br/>
            @if (Model.NonShortlistedSolutions.Any())
            {
                <nhs-card-v2>
                    <nhs-card-content>
                        <nhs-table label-text="Solutions not included">
                            <nhs-table-column>Solution and supplier</nhs-table-column>
                            <nhs-table-column>Justification</nhs-table-column>

                            @foreach (var solution in Model.NonShortlistedSolutions.OrderBy(x => x.CatalogueItem.Name))
                            {
                                <nhs-table-row-container>
                                    <nhs-table-cell>
                                        @solution.CatalogueItem.Name
                                        <br/>
                                        <span class="nhsuk-caption-m nhsuk-caption--bottom">@solution.CatalogueItem.Supplier.LegalName</span>
                                    </nhs-table-cell>
                                    <nhs-table-cell>@solution.Justification</nhs-table-cell>
                                </nhs-table-row-container>
                            }
                        </nhs-table>
                    </nhs-card-content>
                    <nhs-card-footer>
                        <vc:add-or-change href="@changeJustificationsLink" noun-phrase="justifications" is-change="true"/>
                    </nhs-card-footer>
                </nhs-card-v2>
            }

            <nhs-fieldset-form-label asp-for="@Model"
                                     label-text="Confirm shortlist" label-hint="Once you’ve confirmed your shortlist for this competition, you’ll no longer be able to make changes." size="Small">
                <nhs-checkbox-container>
                    <nhs-checkbox label-text="I want to continue with this shortlist" asp-for="@Model.ConfirmShortlist"/>
                </nhs-checkbox-container>

            </nhs-fieldset-form-label>

            <nhs-submit-button text="Confirm shortlist"/>
        </form>
    </div>
</div>
