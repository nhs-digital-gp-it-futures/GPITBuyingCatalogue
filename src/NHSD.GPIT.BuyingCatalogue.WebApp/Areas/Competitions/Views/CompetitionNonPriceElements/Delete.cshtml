@using NHSD.GPIT.BuyingCatalogue.ServiceContracts.Competitions
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Competitions.Models.Shared.Partials
@model DeleteNonPriceElementModel

@{
    ViewBag.Title = "Delete " + Model.SingleElementDisplay.ToLower() + " requirement?";
}

<partial name="Partials/_BackLink" model="Model"/>

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
        <nhs-validation-summary/>
        <nhs-page-title title="@ViewBag.Title"
                        caption="@Model.CompetitionName"
                        advice="@Model.Advice"/>

        <form method="post">
            <h3>@Model.SingleElementDisplay requirement</h3>
            @switch (Model.NonPriceElementType)
            {
                case NonPriceElement.Features:
                    <partial name="Partials/_Features" model="@(new FeaturesPartialModel(Model.InternalOrgId, Model.CompetitionId, Model.NonPriceElementDetails.Features, Model.HasReviewedCriteria, false))" />
                    break;
                case NonPriceElement.Implementation:
                    <partial name="Partials/_Implementation" model="@Model.NonPriceElementDetails.Implementation.Requirements" />
                    break;
                case NonPriceElement.Interoperability:
                    <partial name="Partials/_Interoperability" model="@(new InteroperabilityPartialModel(Model.AvailableIntegrations, Model.NonPriceElementDetails.IntegrationTypes))" />
                    break;
                case NonPriceElement.ServiceLevel:
                    <partial name="Partials/_ServiceLevels" model="@Model.NonPriceElementDetails.ServiceLevel" />
                    break;
            }
            <br/>
            <nhs-button-group>
                <nhs-submit-button text="Delete requirement"/>
                <a href="@Model.BackLink">Cancel</a>
            </nhs-button-group>
        </form>

    </div>
</div>
