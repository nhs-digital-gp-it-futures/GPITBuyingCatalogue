@model NHSD.GPIT.BuyingCatalogue.WebApp.Models.Shared.ServiceRecipientModels.AmendSublocationRecipientsNoSelectionModel;
@{
    ViewBag.Title = Model.Title;
}
<partial name="Partials/_BackLink" model="Model"/>

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
        <nhs-page-title model="@Model"/>

        <p> You can <a href="@Model.BackLink">select new sublocations and service recipients</a>, or continue to the next step without making any changes.</p>
        <div class="nhsuk-u-margin-top-6">
            <vc:nhs-anchor-button text="Save and continue" url="@Model.SaveAndContinueLink" type="Primary"/>
        </div>
    </div>
</div>
