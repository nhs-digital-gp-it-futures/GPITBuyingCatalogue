@using Microsoft.AspNetCore.Mvc.TagHelpers
@using NHSD.GPIT.BuyingCatalogue.UI.Components.Models
@using NHSD.GPIT.BuyingCatalogue.WebApp.Models.Shared.ServiceRecipientModels;
@using NHSD.GPIT.BuyingCatalogue.UI.Components.Views.Shared.Components.NhsAnchorButton
@using NHSD.GPIT.BuyingCatalogue.UI.Components.Views.Shared.TagHelpers.Buttons
@using NHSD.GPIT.BuyingCatalogue.UI.Components.Views.Shared.TagHelpers.InsetText
@using NHSD.GPIT.BuyingCatalogue.UI.Components.Views.Shared.TagHelpers.Table
@using ValidationSummaryTagHelper = NHSD.GPIT.BuyingCatalogue.UI.Components.TagHelpers.ValidationSummaryTagHelper
@model SelectRecipientsV2Model;

@{
    ViewBag.Title = Model.Title;
}
<partial name="Partials/_BackLink" model="Model"/>

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-full">
        <nhs-validation-summary/>
        <nhs-page-title model="@Model"/>

        @if (Model.HasImportedRecipients
             || (Model.PreviouslySelected?.Any() ?? false))
        {
            @if (Model.IsAmendment && (Model.PreviouslySelected?.Any() ?? false))
            {
                <div id="previously-selected-service-recipients">
                    <nhs-details label-text="View Service Recipients from the previous revision" data-test-id="existing-recipients-details">
                        <p>
                            The previous revision had @Model.PreviouslySelected.Count Service @PluralOrSingular(Model.PreviouslySelected.Count)
                        </p>

                        @foreach (var location in Model.PreviouslySelected.GroupBy(x => x.Location))
                        {
                            <nhs-expander label-text="@location.Key"
                                          bold-title="true"
                                          data-test-id="existing-recipient-group-summary">
                                <ul>
                                    @foreach (var item in location)
                                    {
                                        <li>@item.Description</li>
                                    }
                                </ul>
                            </nhs-expander>
                        }
                    </nhs-details>
                </div>
            }
        }

        <h3>Select organisations</h3>
        <div class="bc-u-max-width-full">
            <nhs-button-group>
                <vc:nhs-anchor-button url="@Url.Action(null, new { selectionMode = SelectionMode.All })"
                                      text="Select all"
                                      type="Secondary"/>
                <vc:nhs-anchor-button url="@Url.Action(null, new { selectionMode = SelectionMode.None })"
                                      text="Deselect all"
                                      type="Secondary"/>
            </nhs-button-group>
        </div>

        <form method="post" id="sr-form">
            <input type="hidden" asp-for="Title"/>
            <input type="hidden" asp-for="Caption"/>
            <input type="hidden" asp-for="Advice"/>
            <input type="hidden" asp-for="SelectAtLeast"/>
            <input type="hidden" asp-for="OrganisationName"/>
            <input type="hidden" asp-for="IsAmendment"/>

            @{ var expandWhenNotValid = !ViewData.ModelState.IsValid; }

            <input type="hidden" asp-for="@Model.Sublocation.Name"/>
            <nhs-expander-v2 id="recipients-expander" open="@(expandWhenNotValid || Model.ShouldExpand || Model.Sublocation.ServiceRecipients.Any(x => x.Selected))">
                <nhs-expander-summary label-text="@Model.Sublocation.Name" bold-title="true">
                    <span class="nhsuk-details__summary-text_secondary nhsuk-content--js-only">
                        <b>@(Model.Sublocation.ServiceRecipients.Count(r => r.Selected)) </b>
                        recipients selected
                    </span>
                </nhs-expander-summary>
                <nhs-expander-content>
                    <nhs-table id="sr-table">
                        <nhs-table-column>
                            <div class="nhsuk-checkboxes__item  nhsuk-content--js-only">
                                <input type="checkbox" class="nhsuk-checkboxes__input" name="selectAll" id="selectAll" checked="@Model.Sublocation.AllRecipientsSelected"/>
                                <label for="selectAll" class="nhsuk-label nhsuk-checkboxes__label bold-label">
                                    Organisation
                                </label>
                            </div>
                            <div class="nhsuk-label bold-label non-js-only">Organisation</div>
                        </nhs-table-column>
                        <nhs-table-column>ODS code</nhs-table-column>
                        @foreach (var item in Model.PossibleServiceRecipients)
                        {
                            var checkboxModel = new CheckboxNameAndValueModel() { Name = item.OdsCode, Value = item.Selected };
                            
                            <nhs-table-row-container id="@item.OdsCode" class="recipient">
                                <nhs-table-cell>
                                    <nhs-checkbox-container>
                                        <nhs-checkbox asp-for="@checkboxModel"
                                                      label-text="@item.Name"
                                                      checkbox-class="main-srs gather-data"/>
                                    </nhs-checkbox-container>
                                </nhs-table-cell>
                                <nhs-table-cell>
                                    <div class="nhsuk-input--width-10 nhsuk-u-margin-top-2">@item.OdsCode</div>
                                </nhs-table-cell>
                            </nhs-table-row-container>
                        }
                    </nhs-table>
                </nhs-expander-content>
            </nhs-expander-v2>
            <br/>
            <nhs-button-group>
                <nhs-submit-button/>
            </nhs-button-group>
        </form>
    </div>
</div>

@{
    string PluralOrSingular(int total)
    {
        return total == 1 ? "Recipient:" : "Recipients:";
    }
}
