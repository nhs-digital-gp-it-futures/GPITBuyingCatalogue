@model NHSD.GPIT.BuyingCatalogue.WebApp.Models.Shared.ServiceRecipientModels.RemoveSublocationsModel
@{
    ViewBag.Title = Model.Title;
}
<partial name="Partials/_BackLink" model="Model" />

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
        <nhs-page-title model="@Model"/>
        <p>@Model.ListHeaderText
            <ul>@foreach(var sublocation in @Model.SublocationIdsToRemove){<li>@sublocation</li>}</ul>
        </p>
        
        <nhs-warning-callout label-text="Remove a sublocation">
            Removing a sublocation will also remove any related service recipients that you have previously added.
        </nhs-warning-callout>
        
        <form method="post">
            @for (var i = 0; i < @Model.SublocationIdsToRemove.Count; i++)
            {
                @Html.HiddenFor(model => model.SublocationIdsToRemove[i])
            }

            @for (var i = 0; i < @Model.SublocationIdsToAdd.Count; i++)
            {
                @Html.HiddenFor(model => model.SublocationIdsToAdd[i])
            }

            <nhs-radio-button-container>
                <nhs-radio-button asp-for="ConfirmRemove" value="true" display-text="Yes, I want to remove the @Model.Pluralisation" index="0"/>
                <nhs-radio-button asp-for="ConfirmRemove" value="false" display-text="No, I want to keep the @Model.Pluralisation" index="1"/>
            </nhs-radio-button-container>
            <br/>
            <nhs-submit-button/>
        </form>
    </div>
</div>
