@model NHSD.GPIT.BuyingCatalogue.WebApp.Models.Shared.ServiceRecipientModels.RemoveSublocationsModel
@{
    ViewBag.Title = Model.Title;
}
<partial name="Partials/_BackLink" model="Model" />

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
        <nhs-page-title model="@Model"/>
        <p>@Model.ListHeaderText
            <ul>@foreach(var sublocation in @Model.Removes){<li>@sublocation</li>}</ul>
        </p>
        
        <nhs-warning-callout label-text="Remove a sublocation">
            Removing a sublocation will also remove any related service recipients that you have previously added.
        </nhs-warning-callout>
        
        <form method="post">
            <hidden-inputs title="@Model.Title" caption="@Model.Caption" advice="@Model.Advice" />
            <input type="hidden" asp-for="@Model.Pluralisation"/>
            <input type="hidden" asp-for="@Model.ListHeaderText"/>
            <input type="hidden" asp-for="@Model.BackLink"/>

            @for (var i = 0; i < @Model.SublocationOdsCodes.Count; i++)
            {
                <input type="hidden" asp-for="@Model.SublocationOdsCodes[i]"/>
            }


            @for (var i = 0; i < @Model.Removes.Count; i++)
            {
                <input type="hidden" asp-for="@Model.Removes[i]"/>
            }

            <nhs-fieldset-form-label asp-for="@Model">

                <nhs-radio-buttons asp-for="ConfirmRemove"
                                   values="@Model.ConfirmRemoveOptions"
                                   display-name="Text"
                                   value-name="Value"/>

            </nhs-fieldset-form-label>

            <br/>
            <nhs-submit-button/>
        </form>
    </div>
</div>
