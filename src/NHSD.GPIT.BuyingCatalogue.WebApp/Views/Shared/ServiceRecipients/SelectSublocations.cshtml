@using NHSD.GPIT.BuyingCatalogue.WebApp.Models.Shared.ServiceRecipientModels
@model NHSD.GPIT.BuyingCatalogue.WebApp.Models.Shared.ServiceRecipientModels.SelectSublocationsModel
@{
    ViewBag.Title = Model.Title;
}
<partial name="Partials/_BackLink" model="Model" />

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
        <nhs-page-title model="@Model"/>
        <form method="post">
            @Html.HiddenFor(model => model.Title)
            @Html.HiddenFor(model => model.Caption)
            @Html.HiddenFor(model => model.Advice)

            <nhs-checkbox-container>
                @for (var i = 0; i < Model.RenderedSublocations.Count; i++)
                {
                    @Html.HiddenFor(model => model.RenderedSublocations[i].Name)
                    <nhs-checkbox asp-for="@Model.RenderedSublocations[i].Value"
                                  label-text="@Model.RenderedSublocations[i].Name" />
                }
            </nhs-checkbox-container>
            <br/>
            <nhs-submit-button/>
        </form>
    </div>
</div>
