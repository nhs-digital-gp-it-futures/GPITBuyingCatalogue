@using Microsoft.AspNetCore.Mvc.TagHelpers
@model NHSD.GPIT.BuyingCatalogue.WebApp.Models.Shared.ServiceRecipientModels.ImportServiceRecipients.ValidationCompleteModel
@{
    ViewBag.Title = Model.Title;
}

<partial name="Partials/_BackLink" model="@Model" />
<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
        <nhs-page-title title="@Model.Title"
                        caption="@Model.Caption"
                        advice="@Model.Advice" />
        
        <p>Click save and continue to apply your selected sublocations to the @Model.InteractionNoun.</p>

        <form method="post">
            @for (int i = 0; i < Model.Sublocations.Count; i++)
            {
                @Html.HiddenFor(model => model.Sublocations[i].OdsCode)
                @for (int j = 0; j < Model.Sublocations[i].ServiceRecipientCount; j++)
                {
                    @Html.HiddenFor(model => model.Sublocations[i].ServiceRecipients[j].Name)
                    @Html.HiddenFor(model => model.Sublocations[i].ServiceRecipients[j].OdsCode)
                    @Html.HiddenFor(model => model.Sublocations[i].ServiceRecipients[j].Location)
                }
            }

            <nhs-submit-button/>
        </form>

        <div>
            <a href="@Model.CancelHref">
                Cancel
            </a>
        </div>
    </div>
</div>
