
@using System.Drawing
@model NHSD.GPIT.BuyingCatalogue.WebApp.Models.Shared.ServiceRecipientModels.AddOrConfirmSublocationsModel;

@{
    ViewBag.Title = Model.Title;
}

<partial name="Partials/_BackLink" model="Model" />

<div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
        <nhs-page-title model="@Model"/>
        <nhs-card-v2>
            <nhs-card-content title="Sublocations for @Model.ParentName">
                <nhs-table>
                    <nhs-table-column>Sublocation</nhs-table-column>
                    <nhs-table-column>Organisations added</nhs-table-column>
                    <nhs-table-column>Status</nhs-table-column>
                    <nhs-table-column>Action</nhs-table-column>
                    
                    @foreach (var sublocation in @Model.Sublocations)
                    {
                        <nhs-table-row-container>
                            <nhs-table-cell>@sublocation.Name</nhs-table-cell>
                            <nhs-table-cell>@sublocation.ServiceRecipientCount</nhs-table-cell>
                            <nhs-table-cell>need to do status</nhs-table-cell>
                            <nhs-table-cell><a>Select</a></nhs-table-cell>
                        </nhs-table-row-container>
                    }

                </nhs-table>
            </nhs-card-content>
            <nhs-card-footer>
                <vc:add-or-change href="" noun-phrase="sublocations" />
                </nhs-card-footer>
        </nhs-card-v2>
    </div>
</div>
