@using NHSD.GPIT.BuyingCatalogue.EntityFramework.Extensions;
@using NHSD.GPIT.BuyingCatalogue.EntityFramework.Interfaces
@using NHSD.GPIT.BuyingCatalogue.WebApp.Extensions;
@using NHSD.GPIT.BuyingCatalogue.EntityFramework.Catalogue.Models
@using NHSD.GPIT.BuyingCatalogue.ServiceContracts.Orders
@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.Orders
@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.Orders.AmendOrderItemModel;

<h4>@Model.ItemName</h4>

@{
    var itemType = Model.CatalogueItem.CatalogueItemType.DisplayName();
}

@if (Model.OrderType.MergerOrSplit)
{
    <table>
        <caption>@Model.OrderType.GetPracticeReorganisationRecipientTitle()</caption>
        <tr class="alternating">
            <td>@Model.PracticeReorganisationName</td>
        </tr>
    </table>
}

<table>
    <caption>@Model.OrderType.GetServiceRecipientsTitle()</caption>
    <thead>
        <tr>
            <th>Organisation (ODS code)</th>
            <th>Item ID</th>
            <th>Planned delivery date</th>
            <th class="numeric">Quantity</th>
            @if (Model.IsAmendment && !Model.OrderType.MergerOrSplit)
            {
                <th>Status</th>
            }
        </tr>
    </thead>

    @if (!(Model.RolledUpRecipientsForItem?.Any() ?? false))
    {
        <tr>
            <td style="column-span: all">No service recipients have been entered for this @itemType.</td>
        </tr>
    }
    else
    {
        var orderIdWithCatalogueItem = Model.OrderWrapper.PreviousOrders.SelectMany(o => o.OrderItems).FirstOrDefault(oi => oi.CatalogueItemId == Model.CatalogueItem.Id)?.OrderId;
        @if (Model.IsAmendment)
        {
            @foreach (var serviceRecipient in Model.PreviousRecipientsForItem.OrderBy(recipient =>
                          Model.OrderWrapper.GetCallOffIdForPreviousRecipient(recipient, orderIdWithCatalogueItem)))
            {
                var callOffId = Model.OrderWrapper.GetCallOffIdForPreviousRecipient(serviceRecipient, orderIdWithCatalogueItem);
                var recipientRowModel = new OrderItemRecipientRowModel(serviceRecipient, Model, callOffId);
                <partial name="ServiceRecipientRow" model="recipientRowModel" />
            }
        }
        @foreach (var recipient in Model.RolledUpRecipientsForItem.Where(x => Model.IsServiceRecipientAdded(x.RecipientOdsCode)))
        {
            var recipientRowModel = new OrderItemRecipientRowModel(recipient, Model, Model.CallOffId.ToString());
            <partial name="ServiceRecipientRow" model="recipientRowModel" />
        }
    @if (!Model.OrderType.MergerOrSplit
            && Model.RolledUpRecipientsForItem.Count > 1)
        {
            <tr class="totals">
                @if (Model.IsAmendment)
                {
                    <td />
                }
                <td />
                <td />
                <td />
                <td class="numeric total">
                    @($"{Model.RolledUpRecipientsForItem.Sum(x => x.GetQuantityForItem(Model.CatalogueItem.Id) ?? 0):N0}")
                </td>
            </tr>
        }
    }
</table>

<div class="pdf-container">
    @{
        var hasTieredPricing = Model.OrderItemPrice?.CataloguePriceType is CataloguePriceType.Tiered;

        if (Model.ShouldShowPrice)
        {
            <h4>Pricing and quantities</h4>
            <table>
                <thead>
                    <tr>
                        @if (hasTieredPricing)
                        {
                            <th>Pricing tier</th>
                        }
                        <th>Price per unit</th>
                        @if (Model.CatalogueItem.CatalogueItemType != CatalogueItemType.AssociatedService && Model.IsAmendment)
                        {
                            <th>Old quantity</th>
                            <th>New quantity</th>
                            <th>Old price</th>
                            <th>New price</th>
                        }
                        else
                        {
                            <th>Quantity</th>
                            <th>Total cost</th>
                        }
                    </tr>
                <thead>
                        @{
                            var rolledUpCosts = ((IPrice)Model.OrderItemPrice).CalculateCostPerTier(Model.RolledUpTotalQuantity);
                            var previousCosts = ((IPrice)Model.OrderItemPrice).CalculateCostPerTier(Model.PreviousTotalQuantity);
                            @for (var i = 0; i < rolledUpCosts.Count; i++)
                            {
                            <tr>
                                    @if (hasTieredPricing)
                                    {
                                    <td>Tier @rolledUpCosts[i].Id</td>
                                    }
                                <td>£@rolledUpCosts[i].Price.ToString("N4") @Model.OrderItemPrice.ToPriceUnitString()</td>

                                    @if (Model.CatalogueItem.CatalogueItemType != CatalogueItemType.AssociatedService && Model.IsAmendment)
                                    {
                                    <td>@($"{previousCosts[i].Quantity:N0}")</td>
                                    <td>@($"{rolledUpCosts[i].Quantity:N0}")</td>
                                    <td>£@previousCosts[i].Cost.ToString("N2")</td>
                                    <td>£@rolledUpCosts[i].Cost.ToString("N2")</td>
                                    }
                                    else
                                    {
                                    <td>@($"{rolledUpCosts[i].Quantity:N0}")</td>
                                    <td>£@rolledUpCosts[i].Cost.ToString("N2")</td>
                                    }
                            </tr>
                            }
                        }
            </table>
        }
    }
</div>

<div class="pdf-container">
    <h3>Funding source</h3>
    <p style="padding-top: 8px;">@Model.FundingTypeDescription</p>
    <br />
</div>
