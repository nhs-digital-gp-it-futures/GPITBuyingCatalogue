@model NHSD.GPIT.BuyingCatalogue.WebApp.Areas.Orders.Models.Orders.OrderItemRecipientRowModel
@{
    var quantity = Model.ServiceRecipient.GetQuantityForItem(Model.OrderItemId);
    var deliveryDate = Model.ServiceRecipient.GetDeliveryDateForItem(Model.OrderItemId);
    var deliveryDateText = deliveryDate.HasValue
        ? $"{deliveryDate.Value:d MMMM yyyy}"
        : "No date entered";
    var itemRecipientId = Model.DisplayNumber is null 
        ? $"{Model.CallOffId}-{Model.ServiceRecipient.RecipientOdsCode}-{Model.CatalogueItemId}-{Model.OrderItemId}" 
        : $"{Model.CallOffId}-{Model.ServiceRecipient.RecipientOdsCode}-{Model.DisplayNumber}";
}

<tr class="alternating">
    <td>
        @($"{Model.ServiceRecipient.RecipientOdsOrganisation?.Name} ({Model.ServiceRecipient.RecipientOdsCode})")
    </td>
    <td>
        @itemRecipientId
    </td>
    <td>
        @deliveryDateText
    </td>
    <td class="numeric">
        @(quantity.HasValue ? $"{quantity:N0}" : "N/A")
    </td>
    @if (Model.IsAmendment && !Model.OrderType.MergerOrSplit)
    {
        <td>
            @(!Model.FromPreviousRevision && Model.IsServiceRecipientAdded ? "Added" : "Completed")
        </td>
    }
</tr>
