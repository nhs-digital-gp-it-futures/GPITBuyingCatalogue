@model NHSD.GPIT.BuyingCatalogue.WebApp.Models.Home.ActionCardModel

<div class="@Model.WidthClass nhsuk-card-group__item app-transparent-action-card">
    <nhs-card title="@Model.Title" url="@Model.Url" horizontal-align="true" show-chevron-icon="@Model.ShowChevronIcon" open-in-new-tab="@Model.OpenInNewTab">
        <p class="nhsuk-body">@Model.Text</p>
    </nhs-card>
</div>
