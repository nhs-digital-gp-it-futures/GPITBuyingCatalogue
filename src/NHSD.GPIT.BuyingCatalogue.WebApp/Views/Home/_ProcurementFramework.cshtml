@model NHSD.GPIT.BuyingCatalogue.WebApp.Models.Home.ActionCardModel

<li class="nhsuk-grid-column-one-half nhsuk-card-group__item">
    <nhs-card>
        <h3 class="nhsuk-card__heading nhsuk-heading-s card-title-min-height">
            @if (!string.IsNullOrWhiteSpace(Model.Url))
            {
                <a href="@Model.Url" target="_blank" rel="noopener noreferrer"
                   aria-label="@Model.Title (opens in a new tab)">
                    @Model.Title
                </a>
            }
            else
            {
                @Model.Title
            }
        </h3>

        <p class="nhsuk-card__description card-min-content-height">
            @Model.Text
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.Url) && !string.IsNullOrWhiteSpace(Model.LinkText))
        {
            <p class="nhsuk-card__description">
                <a href="@Model.Url" target="_blank" rel="noopener noreferrer"
                   aria-label="@Model.LinkText (opens in a new tab)">
                    @Model.LinkText
                </a>
            </p>
        }
    </nhs-card>
</li>
