@using NHSD.GPIT.BuyingCatalogue.WebApp.Models.Home
@{
    Layout = "Layouts/_FullWidthLayout";
    ViewBag.Title = "Buying Catalogue";

    // Required for Adobe Analytics (see _HeadIncludes partial for more info)
    ViewBag.PageName = "home";
}

<section class="nhsuk-hero nhsuk-hero--image nhsuk-hero--image-description">
    <div class="nhsuk-hero__overlay">
        <div class="nhsuk-width-container">
            <div class="nhsuk-grid-row">
                <div class=" nhsuk-grid-column-two-thirds">
                    <div class="nhsuk-hero-content">
                        <h1 class="nhsuk-u-margin-bottom-3">
                            <span class="app-main-heading">@ViewBag.Title</span>
                        </h1>
                        <p class="nhsuk-body-l nhsuk-u-margin-bottom-0">Find assured digital solutions for general practice and community pharmacy services.</p>                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="nhsuk-section">
    <div class="nhsuk-width-container app-section__content">
        <div class="nhsuk-grid-row nhsuk-u-padding-top-7">
            <div class="nhsuk-grid-column-full">
                <h2>Choose your healthcare setting</h2>
                <p class="nhsuk-body">Choose your healthcare setting to see solutions, guidance and your procurement next steps</p>
                <div class="nhsuk-grid-row nhsuk-card-group">
                    <partial 
                        name="_ActionCard" 
                        model="@(
                            new ActionCardModel(
                                "ICBs and GP practices", 
                                "Discover solutions and services, run a direct award or on catalogue competition and order digital solutions for your healthcare practices and organisations", 
                                Url.Action(nameof(HomeController.GPIT), typeof(HomeController).ControllerName())) { WidthClass = "nhsuk-grid-column-one-half"})"/>

                    <partial name="_ActionCard" 
                        model="@(
                            new ActionCardModel(
                                "Community Pharmacy", 
                                "Discover assured solutions for Community Pharmacy", 
                                Url.Action(nameof(HomeController.GPIT), typeof(HomeController).ControllerName())) { WidthClass = "nhsuk-grid-column-one-half"})"/>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="nhsuk-section">
    <div class="nhsuk-width-container app-section__content">
        <div class="nhsuk-grid-row app">
            <div class="nhsuk-grid-column-full">
                <h2>Updates</h2>
                <div class="nhsuk-grid-row nhsuk-card-group">
                    <partial 
                        name="_ActionCard" 
                        model="@(
                            new ActionCardModel(
                                "New accessibility standard published", 
                                "New standard for accessibility published and applicable to all solutions", 
                                Url.Action(nameof(HomeController.Index), typeof(HomeController).ControllerName())) { WidthClass = "nhsuk-grid-column-one-half"})"/>

                    <partial name="_ActionCard" 
                        model="@(
                            new ActionCardModel(
                                "New pharmacy solutions onboarded", 
                                "Four new suppliers been added to our Community Pharmacy listings page", 
                                Url.Action(nameof(HomeController.Index), typeof(HomeController).ControllerName())) { WidthClass = "nhsuk-grid-column-one-half"})"/>
                </div>
            </div>
        </div>
    </div>
</section>
