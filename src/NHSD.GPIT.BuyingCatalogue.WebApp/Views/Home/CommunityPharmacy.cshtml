@using NHSD.GPIT.BuyingCatalogue.WebApp.Areas.CommunityPharmacy.Controllers
@using NHSD.GPIT.BuyingCatalogue.WebApp.Models.Home﻿
@{
    Layout = "Layouts/_FullWidthLayout";
    ViewBag.Title = "Solutions for community pharmacies";

    // Required for Adobe Analytics (see _HeadIncludes partial for more info)
    ViewBag.PageName = "CP landing page";
    var steps = new[]
        {
        new StepModel( "Discover solutions", "Explore solutions for NHS services", 1),
        new StepModel( "Evaluate", "Review solution details, including features and pricing", 2),
        new StepModel( "Contact your preferred supplier", "Contact a supplier to discuss your needs", 3)
    };
}

<section class="nhsuk-hero nhsuk-hero--image nhsuk-hero--image-description app-community-pharmacy-hero">
    <div class="nhsuk-hero__overlay">
        <div class="nhsuk-width-container ">
            <div class="nhsuk-grid-row">
                <div class=" nhsuk-grid-column-full">
                    <div class="nhsuk-hero-content" style="max-width: 650px;">
                        <h1 class="nhsuk-u-margin-bottom-3">
                            <span class="app-main-heading" style="display:inline-block; max-width: 22ch;">@ViewBag.Title</span>
                        </h1>
                        <p class="nhsuk-body-l nhsuk-u-margin-bottom-0" style="white-space: nowrap;">
                            Discover solutions for NHS services
                        </p>
                        <a href="@Url.Action(nameof(CommunityPharmacyController.Solutions), typeof(CommunityPharmacyController).ControllerName(), new { Area = typeof(CommunityPharmacyController).AreaName() })"
                           class="nhsuk-u-padding-2 nhsuk-u-margin-top-3 nhsuk-u-margin-bottom-0"
                           style="display:inline-block; border:2px solid #ffffff; border-radius:4px; color:#ffffff; text-decoration:none;">
                            Discover pharmacy solutions
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="nhsuk-section app-steps-section app-steps-section--offset">
    <div class="nhsuk-width-container app-section__content" style="padding-left:0; padding-right:0;">
        <h2 class="nhsuk-heading-l">Steps to follow</h2>

        <ol class="nhsuk-grid-row app-steps-list" role="list">
            @foreach (var step in steps)
            {
                <li class="nhsuk-grid-column-one-third app-step">
                    <span class="app-step__number">@step.Number</span>
                    <h3 class="nhsuk-heading-s nhsuk-u-margin-bottom-1">@step.Title</h3>
                    <p class="nhsuk-body-s nhsuk-u-margin-bottom-0">@step.HelpText</p>
                </li>
            }
        </ol>
    </div>
</section>
<section class="nhsuk-section">
    <div class="nhsuk-width-container app-section__content">
        <div class="nhsuk-grid-row">
            <div class="nhsuk-grid-column-full">
                <h2>Guidance for buyers</h2>
                <ul class="nhsuk-grid-row nhsuk-card-group nhsuk-u-margin-top-5">
                    <partial name="_TransparentActionCard" model="@(new ActionCardModel("How we assure solutions", "Solutions must meet the capabilities and standards set out by the NHS to ensure they are safe and secure for healthcare organisations", Url.Action(nameof(HomeController.CommunityPharmacy), typeof(HomeController).ControllerName())) { ShowChevronIcon = true, WidthClass = "nhsuk-grid-column-one-half" })" />
                    <partial name="_TransparentActionCard" model="@(new ActionCardModel("What to discuss with a supplier", "Guidance for community pharmacists when speaking to suppliers", Url.Action(nameof(HomeController.CommunityPharmacy), typeof(HomeController).ControllerName())) { ShowChevronIcon = true, WidthClass = "nhsuk-grid-column-one-half", OpenInNewTab = true })" />
                </ul>
            </div>
        </div>

    </div>
</section>
<section class="nhsuk-section">
    <div class="nhsuk-width-container app-section__content">
        <div class="nhsuk-grid-row">
            <div class="nhsuk-grid-column-full">
                <h2>Information for suppliers</h2>
                <ul class="nhsuk-grid-row nhsuk-card-group nhsuk-u-margin-top-5">
                    <partial name="_TransparentActionCard" model="@(new ActionCardModel("Become an assured supplier", "Find out how to work with us and become an assured supplier", Url.Action(nameof(HomeController.CommunityPharmacy), typeof(HomeController).ControllerName())) { ShowChevronIcon = false, WidthClass = "nhsuk-grid-column-one-half", OpenInNewTab = true })" />
                    <partial name="_TransparentActionCard" model="@(new ActionCardModel("Roadmap (opens in a new window)", "Information for suppliers about future changes to standards and capalities", "https://nhse-dsic.atlassian.net/wiki/spaces/DCSDR/overview") { ShowChevronIcon = false, WidthClass = "nhsuk-grid-column-one-half", OpenInNewTab = true })" />
                </ul>
            </div>
        </div>
    </div>
</section>

