@model NHSD.GPIT.BuyingCatalogue.UI.Components.Views.Shared.Components.AddOrChange.AddOrChangeModel

@{
    var iconUrl = Model.IsChange ? "/images/fa-pen-to-square.svg" : "/images/plus-icon.svg";

    var verb = string.IsNullOrEmpty(Model.CustomVerb) ? (Model.IsChange ? "Change" : "Add") : Model.CustomVerb;
}

<a class="nhsuk-link nhsuk-link--no-visited-state nhsuk-u-font-size-19" 
style='background-image: url(@iconUrl); background-repeat: no-repeat; background-size: 23px; background-position: center left; padding-left: 32px;' 
href="@Model.Href" 
data-test-id="@Model.TestId">
    @verb @Model.NounPhrase
</a>
